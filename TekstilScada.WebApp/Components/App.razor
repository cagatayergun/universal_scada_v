<!DOCTYPE html>
@using System.Globalization
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Loc

@* Tarayıcı dilini dinamik olarak ayarla (ör: tr-TR veya en-US) *@
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TekstilScada.WebApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    @* --- DEĞİŞİKLİK: Blazor Başlatma Ayarı (Gri Ekranı Engelleme) --- *@
    <script src="_framework/blazor.web.js" autostart="false"></script>

    <script>
        Blazor.start({
            reconnectionHandler: {
                onConnectionDown: (options, error) => {
                    console.warn("Bağlantı zayıf, arka planda tekrar deneniyor...", error);
                },
                onConnectionUp: () => {
                    console.log("Bağlantı tekrar sağlandı.");
                }
            }
        });
    </script>

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/Blazor-ApexCharts/js/apex-charts.min.js"></script>
    <script src="_content/Blazor-ApexCharts/js/blazor-apex-charts.js"></script>
    <script src="https://cdn.plot.ly/plotly-2.31.1.min.js"></script>
    <script src="_content/LiveChartsCore.SkiaSharpView.Blazor/liveChartsCoreBlazor.js"></script>

    <script>
        // --- DİL ÇEVİRİLERİNİ JS TARAFINA AKTARMA ---
        window.appLabels = {
            temperature: '@Loc["Sicaklik"]',
            rpm: '@Loc["Devir"]',
            level: '@Loc["SuSeviyesiLabel"]'
        };

        function getCommonLayout(title, yTitle, isMobile) {
            return {
                title: {
                    text: title,
                    font: { size: isMobile ? 12 : 14, color: '#e0e0e0' },
                    y: 0.95
                },
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'rgba(0,0,0,0)',
                font: { size: isMobile ? 9 : 11, color: '#b0b0b0' },
                margin: { t: 30, b: isMobile ? 25 : 40, l: isMobile ? 30 : 40, r: 10 },
                autosize: true,
                xaxis: {
                    tickcolor: '#9e9e9e', gridcolor: '#333', gridwidth: 0.5,
                    tickangle: isMobile ? 0 : -45, automargin: true
                },
                yaxis: {
                    title: { text: yTitle }, tickcolor: '#9e9e9e',
                    gridcolor: '#333', gridwidth: 0.5, zeroline: false, automargin: true
                },
                showlegend: false
            };
        }

        function plotDashboardCharts(hourlyOeeData, hourlyConsumptionData, topAlarmsData) {
            if (typeof Plotly === 'undefined') {
                setTimeout(() => plotDashboardCharts(hourlyOeeData, hourlyConsumptionData, topAlarmsData), 500);
                return;
            }
            const isMobile = window.innerWidth <= 768;
            const config = { displayModeBar: false, responsive: true };

            const oeeContainer = document.getElementById('oeeChartContainer');
            if (oeeContainer) {
                const data = (hourlyOeeData || []).map(d => ({
                    hour: d.saat !== undefined ? d.saat : (d.Saat !== undefined ? d.Saat : 0),
                    oee: d.averageOEE !== undefined ? d.averageOEE : (d.AverageOEE !== undefined ? d.AverageOEE : 0)
                }));

                const trace = {
                    x: data.map(d => `${d.hour}:00`),
                    y: data.map(d => d.oee),
                    type: 'bar',
                    marker: { color: data.map(d => d.oee < 50 ? '#e74c3c' : '#2ecc71') }
                };
                // ÇEVİRİ: OEEYuzde
                const layout = getCommonLayout('', '@Loc["OEEYuzde"]', isMobile);
                layout.yaxis.range = [0, 100];
                Plotly.newPlot(oeeContainer, [trace], layout, config);
            }

            const plotCons = (id, jsonKey, unit, color) => {
                const container = document.getElementById(id);
                if (!container || !hourlyConsumptionData) return;
                const upperKey = jsonKey.charAt(0).toUpperCase() + jsonKey.slice(1);
                const xValues = hourlyConsumptionData.map(d => {
                    const h = d.saat !== undefined ? d.saat : (d.Saat !== undefined ? d.Saat : d.hour || 0);
                    return `${h}:00`;
                });
                const yValues = hourlyConsumptionData.map(d => d[jsonKey] !== undefined ? d[jsonKey] : (d[upperKey] !== undefined ? d[upperKey] : 0));
                const trace = {
                    x: xValues, y: yValues, type: 'scatter', mode: 'lines+markers',
                    fill: 'tozeroy', line: { color: color, width: 2 }
                };
                Plotly.newPlot(container, [trace], getCommonLayout('', unit, isMobile), config);
            };

            // ÇEVİRİLER: BirimKWh, BirimLitre, BirimKg
            plotCons('electricChartContainer', 'toplamElektrik', '@Loc["BirimKWh"]', '#00bcd4');
            plotCons('waterChartContainer', 'toplamSu', '@Loc["BirimLitre"]', '#2196f3');
            plotCons('steamChartContainer', 'toplamBuhar', '@Loc["BirimKg"]', '#9c27b0');

            const alarmContainer = document.getElementById('topAlarmsChartContainer');
            if (alarmContainer && topAlarmsData) {
                const data = topAlarmsData.slice(0, 5);
                const trace = {
                    x: data.map(d => d.count || d.Count || 0),
                    y: data.map(d => (d.alarmText || d.AlarmText || '').substring(0, isMobile ? 15 : 25) + '...'),
                    type: 'bar', orientation: 'h', marker: { color: '#ff5722' }
                };
                const layout = getCommonLayout('', '', isMobile);
                layout.margin.l = isMobile ? 80 : 150;
                Plotly.newPlot(alarmContainer, [trace], layout, config);
            }
        }

        function drawPieChart(elementId, chartData) {
        if (!document.getElementById(elementId)) return;
        if (!chartData || chartData.length === 0) { Plotly.purge(elementId); return; }
    
        const data = [{
        values: chartData.map(d => d.value),
        labels: chartData.map(d => d.label),
        type: 'pie',
        marker: { colors: chartData.map(d => d.color) },
        hoverinfo: 'label+percent+text',
        text: chartData.map(d => {
        const v = d.value;
        const h = Math.floor(v / 3600).toString().padStart(2,'0');
        const m = Math.floor((v % 3600) / 60).toString().padStart(2,'0');
        return `${h}:${m}`;
        }),
        textinfo: 'percent',
        textfont: { color: '#ffffff' }, // Pasta dilimi içindeki yüzdelik yazılar beyaz
        hole: .4
        }];
    
        const layout = {
        paper_bgcolor: 'rgba(0,0,0,0)',
        font: { color: '#ffffff' }, // Genel grafik yazıları beyaz
        height: 250,
        margin: { t: 10, b: 10, l: 10, r: 10 },
        showlegend: true,
        legend: { font: { color: '#ffffff' } } // Sağ taraftaki (legend) yazılar beyaz
        };
    
        Plotly.newPlot(elementId, data, layout, { responsive: true, displayModeBar: false });
        }

        function drawTimelineChart(elementId, chartData) {
             if (!document.getElementById(elementId)) return;
             if (!chartData || chartData.length === 0) { Plotly.purge(elementId); return; }
             // ÇEVİRİ: Adim
             const steps = chartData.map(d => `@Loc["Adim"] ${d.stepNumber}\n${d.description.substring(0,10)}`);
             const trace = {
                 x: steps, y: chartData.map(d => d.temperature),
                 mode: 'lines+markers', type: 'scatter', name: window.appLabels.temperature, line: { color: '#e74c3c', width: 2 }
             };
             // ÇEVİRİ: AdimSicaklikTrendi, SicaklikDerece
             const layout = getCommonLayout('@Loc["AdimSicaklikTrendi"]', `@Loc["SicaklikDerece"]`, window.innerWidth <= 768);
             layout.xaxis.tickangle = 45;
             Plotly.newPlot(elementId, [trace], layout, { responsive: true });
        }

        function plotTrendChart(chartId, dataPoints, selectedData) {
            if (!document.getElementById(chartId)) return;
            if (!dataPoints) dataPoints = [];

            // 'Z' Temizleme
            const x = dataPoints.map(p => p.timestamp.toString().replace('Z', ''));

            let y, title, color;
            switch (selectedData) {
                case 'Temperature': y = dataPoints.map(p => p.temperature/10.0); title=window.appLabels.temperature; color='#f44336'; break;
                case 'WaterLevel': y = dataPoints.map(p => p.waterLevel); title=window.appLabels.level; color='#2196f3'; break;
                case 'Rpm': y = dataPoints.map(p => p.rpm); title=window.appLabels.rpm; color='#4caf50'; break;
                default: return;
            }
            const trace = { x: x, y: y, mode: 'lines', line: { color: color, width: 2 } };
            Plotly.newPlot(chartId, [trace], getCommonLayout(title, title, false), { responsive: true, displayModeBar: false });
        }

        function plotTrendChart1(chartId, dataPoints, title) {
            if (!document.getElementById(chartId)) return;
            if (!dataPoints) dataPoints = [];

            // 'Z' Temizleme
            const x = dataPoints.map(p => p.timestamp.toString().replace('Z', ''));

            const t1 = { x:x, y:dataPoints.map(d=>d.temperature), name: window.appLabels.temperature, type:'scatter', line:{color:'#e74c3c'}, yaxis:'y1' };
            const t2 = { x:x, y:dataPoints.map(d=>d.rpm), name: window.appLabels.rpm, type:'scatter', line:{color:'#3498db'}, yaxis:'y2' };
            const t3 = { x:x, y:dataPoints.map(d=>d.waterLevel), name: window.appLabels.level, type:'scatter', line:{color:'#2ecc71'}, yaxis:'y3' };

            // ÇEVİRİ: CanliTrend
            const layout = getCommonLayout(title||'@Loc["CanliTrend"]', window.appLabels.temperature, false);
            layout.yaxis.gridcolor='#444';
            layout.yaxis2={ title: window.appLabels.rpm, overlaying:'y', side:'right', position:0.98, showgrid:false, tickfont:{color:'#3498db'} };
            layout.yaxis3={ title: window.appLabels.level, overlaying:'y', side:'right', position:0.90, showgrid:false, tickfont:{color:'#2ecc71'} };
            layout.showlegend=true;
            layout.legend={ x:0, y:1.1, orientation:'h', font:{color:'#ccc'} };

            Plotly.newPlot(chartId, [t1, t2, t3], layout, { responsive: true });
        }

        window.saveAsFile = function (filename, bytesBase64) {
            const link = document.createElement('a');
            link.download = filename;
            link.href = "data:application/octet-stream;base64," + bytesBase64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.plotSyncedDetailCharts = (data, divTempId, divRpmId, divLevelId) => {
            if (!data || data.length === 0) return;

            // 'Z' Temizleme
            var timestamps = data.map(d => d.timestamp.toString().replace('Z', ''));
            var tempData = data.map(d => d.temperature);
            var rpmData = data.map(d => d.rpm);
            var levelData = data.map(d => d.waterLevel);

            var commonLayout = {
                xaxis: { type: 'date', tickformat: '%H:%M', autorange: true },
                margin: { t: 30, b: 30, l: 60, r: 20 }, height: 250, showlegend: false
            };

            // ÇEVİRİ: Sicaklik, SicaklikDerece, Devir, DevirRPM, Seviye, BirimLtYuzde
            var traceTemp = { x: timestamps, y: tempData, mode: 'lines', name: '@Loc["Sicaklik"]', line: { color: '#dc3545', width: 2 }, fill: 'tozeroy' };
            var layoutTemp = Object.assign({}, commonLayout, { title: { text: '@Loc["SicaklikDerece"]', font: { size: 14, color: '#dc3545' } }, yaxis: { title: '°C' } });

            var traceRpm = { x: timestamps, y: rpmData, mode: 'lines', name: '@Loc["Devir"]', line: { color: '#198754', width: 2 } };
            var layoutRpm = Object.assign({}, commonLayout, { title: { text: '@Loc["DevirRPM"]', font: { size: 14, color: '#198754' } }, yaxis: { title: '@Loc["BirimDd"]' } });

            var traceLevel = { x: timestamps, y: levelData, mode: 'lines', name: '@Loc["Seviye"]', line: { color: '#0dcaf0', width: 2 }, fill: 'tozeroy' };
            var layoutLevel = Object.assign({}, commonLayout, { title: { text: '@Loc["Seviye"]', font: { size: 14, color: '#0dcaf0' } }, yaxis: { title: '@Loc["BirimLtYuzde"]' } });

            Plotly.newPlot(divTempId, [traceTemp], layoutTemp, { responsive: true, displayModeBar: false });
            Plotly.newPlot(divRpmId, [traceRpm], layoutRpm, { responsive: true, displayModeBar: false });
            Plotly.newPlot(divLevelId, [traceLevel], layoutLevel, { responsive: true, displayModeBar: false });

            var divTemp = document.getElementById(divTempId);
            var divRpm = document.getElementById(divRpmId);
            var divLevel = document.getElementById(divLevelId);
            var isRelayouting = false;

            function syncZoom(source, targets) {
                source.on('plotly_relayout', function (eventdata) {
                    if (isRelayouting) return;
                    if (eventdata['xaxis.range[0]'] || eventdata['xaxis.autorange']) {
                        isRelayouting = true;
                        var update = {};
                        if(eventdata['xaxis.range[0]']) {
                            update['xaxis.range[0]'] = eventdata['xaxis.range[0]'];
                            update['xaxis.range[1]'] = eventdata['xaxis.range[1]'];
                        }
                        if(eventdata['xaxis.autorange']) {
                            update['xaxis.autorange'] = true;
                        }
                        var promises = targets.map(t => Plotly.relayout(t, update));
                        Promise.all(promises).then(() => setTimeout(() => isRelayouting = false, 50));
                    }
                });
            }
            syncZoom(divTemp, [divRpm, divLevel]);
            syncZoom(divRpm, [divTemp, divLevel]);
            syncZoom(divLevel, [divTemp, divRpm]);
        };

        window.plotRpmGauge = (divId, value, maxValue) => {
            const el = document.getElementById(divId);
            if (!el) return;
            if (!maxValue || maxValue <= 0) maxValue = 1500;
            var data = [
                {
                    type: "indicator", mode: "gauge+number", value: value,
                    // ÇEVİRİ: BirimRPM
                    number: { suffix: " @Loc["BirimRPM"]", font: { size: 22, color: "#333", family: "Arial" } },
                    domain: { x: [0, 1], y: [0, 1] },
                    gauge: {
                        axis: { range: [0, maxValue], tickwidth: 1, tickcolor: "#888", nticks: 6 },
                        bar: { color: "#2c3e50", thickness: 0.25 }, bgcolor: "#f8f9fa",
                        borderwidth: 2, bordercolor: "#eee",
                        steps: [
                            { range: [0, maxValue * 0.33], color: "#198754" },
                            { range: [maxValue * 0.33, maxValue * 0.73], color: "#ffc107" },
                            { range: [maxValue * 0.73, maxValue], color: "#dc3545" }
                        ],
                        threshold: { line: { color: "red", width: 4 }, thickness: 0.75, value: maxValue * 0.95 }
                    }
                }
            ];
            var layout = {
                height: 160, margin: { t: 25, b: 25, l: 30, r: 30 },
                paper_bgcolor: "rgba(0,0,0,0)", plot_bgcolor: "rgba(0,0,0,0)",
                font: { color: "#333", family: "Arial" }, hovermode: false, autosize: true
            };
            Plotly.react(divId, data, layout, { responsive: true, displayModeBar: false, staticPlot: true });
        };

        window.startVnc = async (elementId, url, password) => {
            const { default: RFB } = await import("https://cdn.jsdelivr.net/npm/@@novnc/novnc@1.4.0/core/rfb.js");
            const container = document.getElementById(elementId);
            if(container.rfb) { container.rfb.disconnect(); }
            const rfb = new RFB(container, url, { credentials: { password: password } });
            rfb.scaleViewport = true; rfb.resizeSession = true;
            container.rfb = rfb;
        };

        window.stopVnc = (elementId) => {
            const container = document.getElementById(elementId);
            if (container && container.rfb) { container.rfb.disconnect(); delete container.rfb; }
        };

        window.vncUtils = {
            calculateCoordinates: function (elementId, clientX, clientY) {
                var img = document.getElementById(elementId);
                if (!img) return null;
                var rect = img.getBoundingClientRect();
                var clickX = clientX - rect.left;
                var clickY = clientY - rect.top;
                var naturalW = img.naturalWidth;
                var naturalH = img.naturalHeight;
                var displayedW = rect.width;
                var displayedH = rect.height;
                if (naturalW === 0 || naturalH === 0) return null;
                var imageRatio = naturalW / naturalH;
                var containerRatio = displayedW / displayedH;
                var renderW, renderH, offsetX, offsetY;
                if (containerRatio > imageRatio) {
                    renderH = displayedH; renderW = renderH * imageRatio;
                    offsetX = (displayedW - renderW) / 2; offsetY = 0;
                } else {
                    renderW = displayedW; renderH = renderW / imageRatio;
                    offsetX = 0; offsetY = (displayedH - renderH) / 2;
                }
                if (clickX < offsetX || clickX > offsetX + renderW || clickY < offsetY || clickY > offsetY + renderH) return null;
                var relativeX = clickX - offsetX; var relativeY = clickY - offsetY;
                var finalX = Math.floor(relativeX * (naturalW / renderW));
                var finalY = Math.floor(relativeY * (naturalH / renderH));
                return { x: finalX, y: finalY };
            },
            setupUnloadHandler: function (dotNetHelper) {
                window.addEventListener("beforeunload", function (e) {
                    dotNetHelper.invokeMethodAsync("OnPageUnload");
                });
            }
        };

        window.plotSyncedTrendCharts = (data, divTempId, divRpmId, divLevelId) => {
            if (!data || data.length === 0) return;

            // 'Z' Temizleme
            var timestamps = data.map(d => d.timestamp.toString().replace('Z', ''));
            var tempData = data.map(d => d.temperature / 10.0);
            var rpmData = data.map(d => d.rpm);
            var levelData = data.map(d => d.waterLevel);

            var commonLayout = {
                xaxis: { type: 'date', tickformat: '%H:%M:%S', autorange: true },
                margin: { t: 30, b: 40, l: 60, r: 20 }, showlegend: false
            };

            // ÇEVİRİ: SicaklikDerece, DevirDd, SeviyeYuzde
            Plotly.newPlot(divTempId, [{ x: timestamps, y: tempData, mode: 'lines', line: { color: '#dc3545' }, fill: 'tozeroy' }], Object.assign({}, commonLayout, { yaxis: { title: '@Loc["SicaklikDerece"]' } }));
            Plotly.newPlot(divRpmId, [{ x: timestamps, y: rpmData, mode: 'lines', line: { color: '#198754' } }], Object.assign({}, commonLayout, { yaxis: { title: '@Loc["DevirDd"]' } }));
            Plotly.newPlot(divLevelId, [{ x: timestamps, y: levelData, mode: 'lines', line: { color: '#0dcaf0' }, fill: 'tozeroy' }], Object.assign({}, commonLayout, { yaxis: { title: '@Loc["SeviyeYuzde"]' } }));

            var divTemp = document.getElementById(divTempId);
            divTemp.on('plotly_relayout', function (eventdata) {
                if (eventdata['xaxis.range[0]'] || eventdata['xaxis.autorange']) {
                    Plotly.relayout(divRpmId, eventdata); Plotly.relayout(divLevelId, eventdata);
                }
            });
            document.getElementById(divRpmId).on('plotly_relayout', function (eventdata) {
                if (eventdata['xaxis.range[0]'] || eventdata['xaxis.autorange']) {
                    Plotly.relayout(divTempId, eventdata); Plotly.relayout(divLevelId, eventdata);
                }
            });
            document.getElementById(divLevelId).on('plotly_relayout', function (eventdata) {
                if (eventdata['xaxis.range[0]'] || eventdata['xaxis.autorange']) {
                    Plotly.relayout(divTempId, eventdata); Plotly.relayout(divRpmId, eventdata);
                }
            });
        };

        window.plotSyncedCharts = (data) => {
            if (!data || data.length === 0) return;

            // 'Z' Temizleme
            const timestamps = data.map(d => d.timestamp.toString().replace('Z', ''));
            const temps = data.map(d => d.temperature / 10.0);
            const levels = data.map(d => d.waterLevel);
            const rpms = data.map(d => d.rpm);

            const commonLayout = { xaxis: { type: 'date', showgrid: true }, margin: { l: 50, r: 20, t: 30, b: 30 }, showlegend: false };

            // ÇEVİRİ: SicaklikDerece, SuSeviyesiYuzde, DevirRPM
            Plotly.newPlot('tempChart', [{ x: timestamps, y: temps, mode: 'lines', line: { color: '#e74c3c' }, fill: 'tozeroy' }], { ...commonLayout, title: '@Loc["SicaklikDerece"]', yaxis: { title: '°C' } });
            Plotly.newPlot('levelChart', [{ x: timestamps, y: levels, mode: 'lines', line: { color: '#3498db' }, fill: 'tozeroy' }], { ...commonLayout, title: '@Loc["SuSeviyesiYuzde"]', yaxis: { title: '%' } });
            Plotly.newPlot('rpmChart', [{ x: timestamps, y: rpms, mode: 'lines', line: { color: '#2ecc71' } }], { ...commonLayout, title: '@Loc["DevirRPM"]', yaxis: { title: 'rpm' } });

            const charts = [document.getElementById('tempChart'), document.getElementById('levelChart'), document.getElementById('rpmChart')];
            charts.forEach(chart => {
                chart.on('plotly_relayout', (eventdata) => {
                    if (eventdata._source === 'sync') return;
                    charts.forEach(otherChart => {
                        if (otherChart !== chart) {
                            Plotly.relayout(otherChart, { 'xaxis.range[0]': eventdata['xaxis.range[0]'], 'xaxis.range[1]': eventdata['xaxis.range[1]'], _source: 'sync' });
                        }
                    });
                });
            });
        };

        window.plotSyncedChartsWithLimits = (data, startTime, endTime) => {
            if (!data || data.length === 0 || !document.getElementById('tempChart')) return;

            // 'Z' Temizleme
            const timestamps = data.map(d => d.timestamp.toString().replace('Z', ''));
            const temps = data.map(d => d.temperature / 10.0);
            const levels = data.map(d => d.waterLevel);
            const rpms = data.map(d => d.rpm);

            const commonLayout = {
                xaxis: { type: 'date', range: [startTime, endTime], showgrid: true, gridcolor: '#eee', zeroline: false },
                margin: { l: 50, r: 20, t: 30, b: 30 }, paper_bgcolor: "transparent", plot_bgcolor: "transparent",
                showlegend: false, font: { family: 'Segoe UI, Arial', size: 11, color: '#666' }
            };

            // ÇEVİRİ: SicaklikDerece, SuSeviyesiYuzde, DevirRPM
            Plotly.newPlot('tempChart', [{ x: timestamps, y: temps, mode: 'lines', line: { color: '#e74c3c' }, fill: 'tozeroy' }], { ...commonLayout, title: { text: '@Loc["SicaklikDerece"]', font: { size: 12 } } });
            Plotly.newPlot('levelChart', [{ x: timestamps, y: levels, mode: 'lines', line: { color: '#3498db' }, fill: 'tozeroy' }], { ...commonLayout, title: { text: '@Loc["SuSeviyesiYuzde"]', font: { size: 12 } } });
            Plotly.newPlot('rpmChart', [{ x: timestamps, y: rpms, mode: 'lines', line: { color: '#2ecc71' } }], { ...commonLayout, title: { text: '@Loc["DevirRPM"]', font: { size: 12 } } });

            const chartIds = ['tempChart', 'levelChart', 'rpmChart'];
            chartIds.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.on('plotly_relayout', function (eventdata) {
                    if (eventdata._source === 'sync') return;
                    if (eventdata['xaxis.range[0]'] || eventdata['xaxis.autorange']) {
                        const update = { 'xaxis.range[0]': eventdata['xaxis.range[0]'], 'xaxis.range[1]': eventdata['xaxis.range[1]'], 'xaxis.autorange': eventdata['xaxis.autorange'], _source: 'sync' };
                        chartIds.forEach(targetId => { if (targetId !== id) Plotly.relayout(targetId, update); });
                    }
                });
            });
        };
    </script>
    <script>
        window.drawEfficiencyTimeline = function (data, elementId) {
        if (!data || data.length === 0) return;

        var traces = [];
        var states = {
        "AUTO": { color: "#10B981", name: "AUTO", x: [], y: [], base: [], text: [] },
        "WAIT": { color: "#EF4444", name: "WAIT", x: [], y: [], base: [], text: [] },
        "IDLE": { color: "#EF4444", name: "IDLE", x: [], y: [], base: [], text: [] },
        "MANUAL": { color: "#F59E0B", name: "MANUEL", x: [], y: [], base: [], text: [] }
        };

        data.forEach(item => {
        // HATA ÇÖZÜMÜ: Eğer bitiş tarihi yoksa (null) bu satırı grafiğe çizme
        if (!item.endTime) return;

        var state = item.state || "IDLE";
        if (!states[state]) state = "IDLE";

        var start = new Date(item.startTime);
        var end = new Date(item.endTime);
        
        // Ekstra Güvenlik: Yıl 2000'den küçükse (1970 gibi) hatalı veri kabul et ve atla
        if (start.getFullYear() < 2000 || end.getFullYear() < 2000) return;

        var durationMs = end - start;

        states[state].y.push(item.machineName);
        states[state].base.push(start.toISOString());
        states[state].x.push(durationMs);

        var reason = item.reason1 ? " - " + item.reason1 : "";
        var tooltip = `<b>${item.machineName}</b><br>${item.state}${reason}<br>${start.toLocaleTimeString()} - ${end.toLocaleTimeString()}`;
        states[state].text.push(tooltip);
        });

        for (var key in states) {
        if (states[key].x.length > 0) {
        traces.push({
        name: states[key].name,
        type: 'bar',
        orientation: 'h',
        y: states[key].y,
        x: states[key].x,
        base: states[key].base,
        marker: { color: states[key].color },
        text: states[key].text,
        hoverinfo: 'text',
        textposition: 'none'
        });
        }
        }

        var layout = {
        barmode: 'overlay',
        showlegend: true,
        xaxis: { type: 'date', title: 'TIME' },
        yaxis: { title: 'MACHINE', autorange: 'reversed' },
        margin: { l: 120, r: 20, t: 30, b: 40 }
        };

        if (typeof Plotly !== 'undefined') {
        Plotly.newPlot(elementId, traces, layout, { responsive: true });
        }
        };
    </script>
</body>
</html>