@inherits LayoutComponentBase
@using Telemetry.WebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using System.Security.Claims
@using Telemetry.WebApp.Components.Shared
@using Telemetry.Core.Localization
@using Microsoft.Extensions.Localization

@inject Telemetry.WebApp.Services.ScadaDataService ScadaService
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc
@inject ISnackbar Snackbar
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* <AlarmBanner /> BİLEŞENİ KALDIRILDI *@

    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="MudBlazor.Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">YILMAK TELEMETRY</MudText>

        <MudSpacer />

        <LanguageSwitcher />

        <AuthorizeView>
            <Authorized>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-4">
                    <MudText Typo="Typo.body2"><b>@context.User.Identity?.Name</b></MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="MudBlazor.Color.Inherit" OnClick="HandleLogout" Title="@Loc["CikisYap2"]" />
                </MudStack>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Secondary" Link="/login" Class="ml-4">@Loc["GirisYap"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private bool _isInitialized = false;
    private int _currentUserId = 0;

    // _machinesWithAlarm HASHSET'İ KALDIRILDI (Artık ihtiyaç yok)

    private readonly string[] _publicPages = new[]
    {
        "select-factory",
        "login",
        "logout",
        "portal",
        "admin"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!_isInitialized)
        {
            await GetCurrentUserAsync();
            NavigationManager.LocationChanged += HandleLocationChanged;

            // CheckAlarms EVENT ABONELİĞİ KALDIRILDI
            // ScadaService.OnDataUpdated += CheckAlarms;

            _isInitialized = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScadaService.InitializeAsync();

            // Güvenlik Kontrolü
            CheckFactorySelection();

            if (ScadaService.HubConnection != null)
            {
                ScadaService.HubConnection.Closed += async (error) =>
                {
                    ScadaService.ExitFactory();
                    Snackbar.Add(@Loc["sunucukopuk"], Severity.Error, config =>
                    {
                        config.Icon = Icons.Material.Filled.WifiOff;
                        config.VisibleStateDuration = 5000;
                    });

                    await InvokeAsync(() =>
                    {
                        NavigationManager.NavigateTo("/select-factory");
                    });
                };
            }
        }
    }

    private async Task CheckFactorySelection()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();

        if (_publicPages.Any(page => relativePath.StartsWith(page)))
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("SystemAdmin"))
        {
            NavigationManager.NavigateTo("/admin");
            return;
        }
        if (user.IsInRole("CompanyAdmin"))
        {
            NavigationManager.NavigateTo("/portal");
            return;
        }

        if (string.IsNullOrEmpty(ScadaService.CurrentFactoryName))
        {
            NavigationManager.NavigateTo("/select-factory");
        }
    }

    // CheckAlarms METODU TAMAMEN KALDIRILDI

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task HandleLogout()
    {
        if (_currentUserId > 0)
        {
            await ScadaService.LogUserActionAsync(_currentUserId, @Loc["Oturum_Kapatma"], @Loc["Kullanıcı_çıkış_yaptı"]);
        }

        await AuthProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    private async Task GetCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                _currentUserId = id;
            }
        }
        else
        {
            _currentUserId = 0;
        }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await GetCurrentUserAsync();

        if (_currentUserId > 0)
        {
            var relativePath = NavigationManager.ToBaseRelativePath(e.Location);
            if (string.IsNullOrEmpty(relativePath)) relativePath = @Loc["anasayfa"];
            _ = ScadaService.LogUserActionAsync(_currentUserId, @Loc["sayfaziyareti"], @Loc["GoruntulenenSayfa", relativePath]);
        }

        CheckFactorySelection();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;

        // Event aboneliği zaten yukarıda silindiği için buradaki çıkarma işlemine de gerek kalmadı.
        // if (ScadaService != null) { ScadaService.OnDataUpdated -= CheckAlarms; }
    }
}