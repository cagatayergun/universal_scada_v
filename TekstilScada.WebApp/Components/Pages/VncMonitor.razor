@page "/vnc-monitor1/{MachineId:int}"
@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Microsoft.AspNetCore.SignalR.Client
@inject ScadaDataService ScadaService
@inject VncSessionService VncSessionService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS  // <-- 1. YENİ: JS Runtime Eklendi
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Class="mr-3 mb-n1" />
            @if (machine != null)
            {
                        @($"{Loc["UzaktanErisim"]} - {machine.MachineName}")
            }
            else
            {
                        @Loc["UzaktanErisim"]
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isAccessDenied)
        {
                     <MudAlert Severity="Severity.Warning">
                        Erişim Reddedildi!
                        Şu an başka bir operatör (@currentViewerName) bu makineyi izliyor.
                    </MudAlert>
        }
        else if (machine == null)
        {
                     <div class="d-flex flex-column justify-center align-center py-8" style="height: 300px;">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Class="mt-4">Makine bilgileri yükleniyor...</MudText>
                    </div>
        }
        else
        {
                    @* --- YENİ SİSTEM: SIGNALR GÖRÜNTÜ PANELİ --- *@
                    <div style="width: 100%; min-height: 400px; display: flex; justify-content: center; align-items: center; background-color: #000; border: 1px solid #333;">
                        @if (!string.IsNullOrEmpty(imageData))
                        {
                                    @* 2. YENİ: ID eklendi, onmousedown eklendi, cursor pointer yapıldı *@
                                    <img id="vncStreamImage"
                                         src="data:image/jpeg;base64,@imageData"
                                         style="max-width: 100%; max-height: 600px; object-fit: contain; cursor: pointer;"
                                         @onmousedown="HandleImageClick"
                                         @ontouchstart="HandleTouchClick" />
                                         @* Mobil ve PC için ayrı eventler gerekebilir, şimdilik mouse yeterli olabilir ama touch eklemek garanti olur *@
                        }
                        else
                        {
                                    <div class="d-flex flex-column align-center">
                                        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                                        <MudText Class="mt-2" Typo="Typo.caption" Color="Color.Surface">Görüntü Bekleniyor...</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity:0.5; font-size:10px;">(Gateway bağlantısı kontrol ediliyor)</MudText>
                                    </div>
                        }
                    </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseConnection" Color="Color.Error" Variant="Variant.Filled">Kapat</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ... (Önceki değişkenler aynı) ...
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int MachineId { get; set; }

    private Machine? machine;
    private bool isAccessDenied = false;
    private string? currentViewerName;
    private string myUserName = "Operator";
    private HubConnection? hubConnection;
    private string? imageData;

    // ... (OnInitializedAsync Metodu Aynı) ...
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var machines = await ScadaService.GetMachinesAsync();
            if (machines != null) machine = machines.FirstOrDefault(m => m.Id == MachineId);

            var result = VncSessionService.TryEnterSession(MachineId, myUserName);
            if (!result.Success)
            {
                isAccessDenied = true;
                currentViewerName = result.CurrentUser;
                return;
            }
            await StartSignalRConnection();
        }
        catch (Exception ex) { Console.WriteLine($"Init Error: {ex.Message}"); }
    }

    // ... (StartSignalRConnection Metodu Aynı - BAŞLAT komutuyla birlikte) ...
    private async Task StartSignalRConnection()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var hubUrl = "https://api.malkanteknolojionline.com.tr/scadaHub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options => { options.AccessTokenProvider = () => Task.FromResult(token); })
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<int, string>("ReceiveScreenImage", (mId, base64) =>
            {
                if (mId == MachineId)
                {
                    imageData = base64;
                    InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();

            if (machine != null)
            {
                string vncParams = $"{machine.VncAddress};{machine.VncPassword}";
                await hubConnection.InvokeAsync("SendCommandToLocal", MachineId, "START_VNC", vncParams);
            }
        }
        catch (Exception ex) { Console.WriteLine($"SignalR Error: {ex.Message}"); }
    }

    // --- 3. YENİ: TIKLAMA HESAPLAMA VE GÖNDERME METODU ---
    private async Task HandleImageClick(MouseEventArgs e)
    {
        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                // JS Fonksiyonunu çağırıp düzeltilmiş koordinatları alıyoruz
                // MouseEventArgs.ClientX ve ClientY ekran koordinatlarını verir
                var coords = await JS.InvokeAsync<Coordinates>("vncUtils.calculateCoordinates", "vncStreamImage", e.ClientX, e.ClientY);

                if (coords != null)
                {
                    // Koordinatları Gateway'e gönder (Format: "X;Y")
                    await hubConnection.InvokeAsync("SendCommandToLocal", MachineId, "CLICK", $"{coords.X};{coords.Y}");
                    Console.WriteLine($"Click Sent: {coords.X}, {coords.Y}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Click Error: {ex.Message}");
            }
        }
    }

    // Dokunmatik ekranlar için (Opsiyonel ama önerilir)
    private async Task HandleTouchClick(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            var touch = e.Touches[0];
            // Touch olayını mouse olayına benzer şekilde işleyebiliriz
            if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
            {
                try
                {
                    var coords = await JS.InvokeAsync<Coordinates>("vncUtils.calculateCoordinates", "vncStreamImage", touch.ClientX, touch.ClientY);
                    if (coords != null)
                    {
                        await hubConnection.InvokeAsync("SendCommandToLocal", MachineId, "CLICK", $"{coords.X};{coords.Y}");
                    }
                }
                catch { }
            }
        }
    }

    // JS'den dönen veri için yardımcı sınıf
    public class Coordinates
    {
        public int X { get; set; }
        public int Y { get; set; }
    }
    // -----------------------------------------------------

    private void CloseConnection()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            try { await hubConnection.InvokeAsync("SendCommandToLocal", MachineId, "STOP_VNC", ""); } catch { }
        }
        if (hubConnection is not null) await hubConnection.DisposeAsync();
        if (!isAccessDenied) VncSessionService.ExitSession(MachineId, myUserName);
    }
}