@page "/makine-detay/{MachineId:int}"

@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.Repositories
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject ScadaDataService ScadaDataService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

<PageTitle>@string.Format(Loc["MakineDetayPageTitle"], MachineId, Status?.MachineName)</PageTitle>

@if (Status == null)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    @* --- ÜST DURUM PANELİ --- *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@Status.MachineName <small class="text-muted fs-6">(@Status.MakineTipi)</small></h2>
        <div>
            <span class="badge @GetConnectionCssClass() p-2">@Status.ConnectionState</span>
            <span class="badge bg-dark p-2 ms-2">@GetStatusText()</span>
        </div>
    </div>

    @* --- GÖSTERGELER (BARLAR VE İBRE) --- *@
    <div class="row mb-4">
        @* Sıcaklık Dikey Bar *@
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm border-danger border-top border-4">
                <div class="card-header bg-white py-1 fw-bold text-danger text-center">@Loc["Sicaklik"]</div>
                <div class="card-body d-flex align-items-center justify-content-around">
                    <div class="v-gauge-container">
                        <div class="v-gauge-fill bg-danger" style="height: @(GetTemperaturePercentage())%;"></div>
                    </div>
                    <div class="text-center">
                        <h2 class="text-danger fw-bold mb-0">@GetFormattedTemperature()</h2>
                        <small class="text-muted fw-bold">°C</small>
                    </div>
                </div>
            </div>
        </div>

        @* Devir İbre (180 Derece) *@
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm border-success border-top border-4">
                <div class="card-header bg-white py-1 fw-bold text-success text-center">
                    @Loc["Devir"]
                </div>
                <div class="card-body p-0 d-flex flex-column align-items-center justify-content-center" style="min-height: 160px;">
                    @* Grafik buraya gelecek, config içindeki staticPlot sayesinde üzerine gelince hiçbir şey çıkmaz *@
                    <div id="gaugeRpmContainer" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        @* Su Seviyesi Dikey Bar *@
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm border-primary border-top border-4">
                <div class="card-header bg-white py-1 fw-bold text-primary text-center">@(IsDryerMachine() ? "Nem (Rh)" : Loc["SuSeviyesiLabel"])</div>
                <div class="card-body d-flex align-items-center justify-content-around">
                    <div class="v-gauge-container border-primary">
                        <div class="v-gauge-fill bg-primary" style="height: @(Math.Min(100, (double)Status.AnlikSuSeviyesi))%;"></div>
                    </div>
                    <div class="text-center">
                        <h2 class="text-primary fw-bold mb-0">@Status.AnlikSuSeviyesi</h2>
                        <small class="text-muted fw-bold">@(IsDryerMachine() ? "Rh" : "Lt")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- MÜŞTERİ / SİPARİŞ BİLGİ KUTUCUKLARI (KPI BOX) --- *@
    <div class="row mb-4 g-2">
        <div class="col-6 col-md-3">
            <div class="kpi-box border-start border-4 border-warning shadow-sm bg-white p-2">
                <label class="text-muted small fw-bold text-uppercase d-block">@Loc["MusteriNoLabel"]</label>
                <div class="h6 fw-bold mb-0">@(string.IsNullOrEmpty(Status.MusteriNumarasi) ? "---" : Status.MusteriNumarasi)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-box border-start border-4 border-info shadow-sm bg-white p-2">
                <label class="text-muted small fw-bold text-uppercase d-block">@Loc["SiparisNoLabel"]</label>
                <div class="h6 fw-bold mb-0">@(string.IsNullOrEmpty(Status.SiparisNumarasi) ? "---" : Status.SiparisNumarasi)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-box border-start border-4 border-success shadow-sm bg-white p-2">
                <label class="text-muted small fw-bold text-uppercase d-block">@Loc["BatchLabel"]</label>
                <div class="h6 fw-bold mb-0">@(string.IsNullOrEmpty(Status.BatchNumarasi) ? "---" : Status.BatchNumarasi)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-box border-start border-4 border-primary shadow-sm bg-white p-2">
                <label class="text-muted small fw-bold text-uppercase d-block">@Loc["ReceteLabel"]</label>
                <div class="h6 fw-bold mb-0">@(string.IsNullOrEmpty(Status.RecipeName) ? "---" : Status.RecipeName)</div>
            </div>
        </div>
    </div>

    @* --- SEKMELER --- *@
    <div class="card shadow-sm">
        <div class="card-header p-0">
            <ul class="nav nav-tabs nav-fill">
                <li class="nav-item"><button class="nav-link rounded-0 @(ActiveTab == "steps" ? "active" : "")" @onclick="@(() => ChangeTab("steps"))">@Loc["PlcReceteAdimlari"]</button></li>
                <li class="nav-item"><button class="nav-link rounded-0 @(ActiveTab == "trend" ? "active" : "")" @onclick="@(() => ChangeTab("trend"))">@Loc["TrendAnaliziTab"]</button></li>
                <li class="nav-item"><button class="nav-link rounded-0 @(ActiveTab == "alarm" ? "active" : "")" @onclick="@(() => ChangeTab("alarm"))">@Loc["AlarmGecmisiTab"]</button></li>
            </ul>
        </div>
        <div class="card-body">
            @if (ActiveTab == "steps")
            {
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-hover table-bordered mb-0">
                        <thead class="table-light sticky-top"><tr><th width="70" class="text-center">No</th><th>@Loc["Aciklama"]</th></tr></thead>
                        <tbody>
                            @if (RecipeSteps != null)
                            {
                                foreach (var step in RecipeSteps.Where(s => !string.IsNullOrEmpty(GetStepTypeName(s))))
                                {
                                    <tr class="@(step.StepNumber == Status.AktifAdimNo ? "table-success fw-bold" : "")">
                                        <td class="text-center">@step.StepNumber</td>
                                        <td>@GetStepTypeName(step)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (ActiveTab == "trend")
            {
                if (isLoading)
                {

                    <div class="text-center p-5"><div class="spinner-border"></div></div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 bg-light p-2 rounded">
                        <div id="chartTemp" class="bg-white rounded"></div>
                        <div id="chartRpm" class="bg-white rounded"></div>
                        <div id="chartLevel" class="bg-white rounded"></div>
                    </div>
                }
            }
            else if (ActiveTab == "alarm")
            {
                <div class="table-responsive">
                    <table class="table table-striped table-sm border mb-0">
                        <thead class="table-dark"><tr><th>@Loc["BaslangicZamani"]</th><th>@Loc["Aciklama"]</th><th>@Loc["Sure"]</th></tr></thead>
                        <tbody>
                            @if (AlarmHistory != null)
                            {
                                foreach (var alarm in AlarmHistory)
                                {
                                    <tr><td>@alarm.StartTime.ToString("HH:mm:ss")</td><td>@alarm.AlarmText</td><td>@alarm.Duration</td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<style>
    .v-gauge-container {
        width: 25px;
        height: 110px;
        background: #eee;
        border: 1px solid #ccc;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .v-gauge-fill {
        width: 100%;
        position: absolute;
        bottom: 0;
        transition: height 0.5s ease;
    }

    .kpi-box {
        height: 100%;
    }

    .nav-tabs .nav-link.active {
        font-weight: bold;
        border-bottom: 3px solid #0d6efd;
    }
</style>

@code {
    [Parameter] public int MachineId { get; set; }
    private FullMachineStatus? Status;
    private string ActiveTab = "steps";
    private bool isLoading = false;
    private bool shouldRenderChart = false;
    private List<AlarmReportItem>? AlarmHistory;
    private List<ScadaRecipeStep>? RecipeSteps;
    private List<TrendDataPointRich>? TrendData;

    public class TrendDataPointRich { public DateTime Timestamp { get; set; } public double Temperature { get; set; } public double Rpm { get; set; } public double WaterLevel { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        await ScadaDataService.GetMachinesAsync();
        ScadaDataService.OnDataUpdated += HandleDataUpdate;
        if (ScadaDataService.MachineData.TryGetValue(MachineId, out var s)) Status = s;
        await LoadRecipeStepsAsync();
    }

    private void HandleDataUpdate()
    {
        if (ScadaDataService.MachineData.TryGetValue(MachineId, out var newStatus))
        {
            Status = newStatus;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (shouldRenderChart && ActiveTab == "trend")
            {
                shouldRenderChart = false;
                await JSRuntime.InvokeVoidAsync("plotSyncedDetailCharts", TrendData, "chartTemp", "chartRpm", "chartLevel");
            }
            if (Status != null) await JSRuntime.InvokeVoidAsync("plotRpmGauge", "gaugeRpmContainer", Status.AnlikDevirRpm);
        }
        catch { }
    }

    private async Task ChangeTab(string t) { ActiveTab = t; if (t != "steps") await LoadReportData(); }

    private async Task LoadReportData()
    {
        isLoading = true;
        shouldRenderChart = false;
        TrendData = null;
        AlarmHistory = null;
        StateHasChanged();

        try
        {
            bool isBatchMode = Status != null && !string.IsNullOrEmpty(Status.BatchNumarasi) && Status.IsInRecipeMode;
            DateTime startTime = isBatchMode ? DateTime.MinValue : DateTime.Now.AddHours(-3);

            var filter = new ReportFilters
            {
                MachineId = MachineId,
                StartTime = startTime,
                EndTime = DateTime.Now,
                BatchNo = isBatchMode ? Status!.BatchNumarasi : null
            };

            // 1. ALARM GEÇMİŞİ YÜKLEME
            if (ActiveTab == "alarm")
            {
                if (isBatchMode)
                {
                    var detail = await ScadaDataService.GetProductionDetailAsync(MachineId, Status!.BatchNumarasi);
                    AlarmHistory = detail?.Alarms.Select(a => new AlarmReportItem
                    {
                        StartTime = a.AlarmTime,
                        AlarmText = a.AlarmDescription,
                        Duration = a.Duration.ToString(@"hh\:mm\:ss")
                    }).OrderByDescending(x => x.StartTime).ToList();
                }
                else
                {
                    AlarmHistory = (await ScadaDataService.GetAlarmReportAsync(filter)).OrderByDescending(x => x.StartTime).ToList();
                }
            }

            // 2. TREND VERİSİ YÜKLEME (Hatanın olduğu kısım burasıydı)
            else if (ActiveTab == "trend")
            {
                // Veriyi generic bir liste olarak tanımlıyoruz
                System.Collections.IEnumerable? rawDataRaw = null;

                if (isBatchMode)
                {
                    var detail = await ScadaDataService.GetProductionDetailAsync(MachineId, Status!.BatchNumarasi);
                    rawDataRaw = detail?.LogData;
                }
                else
                {
                    rawDataRaw = await ScadaDataService.GetTrendDataAsync(filter);
                }

                if (rawDataRaw != null)
                {
                    // Her iki tipi de JSON üzerinden ortak DTO'muza güvenli bir şekilde dönüştürüyoruz
                    var jsonString = JsonSerializer.Serialize(rawDataRaw);
                    var deserialized = JsonSerializer.Deserialize<List<TrendDataPointRich>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                    bool isDry = IsDryerMachine();
                    TrendData = deserialized?.Select(d => new TrendDataPointRich
                    {
                        Timestamp = d.Timestamp,
                        Temperature = isDry ? d.Temperature / 100.0 : d.Temperature / 10.0,
                        Rpm = d.Rpm,
                        WaterLevel = d.WaterLevel
                    }).OrderBy(x => x.Timestamp).ToList();

                    shouldRenderChart = (TrendData != null && TrendData.Any());
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Veri yükleme hatası: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadRecipeStepsAsync()
    {
        try { var r = await ScadaDataService.ReadRecipeFromPlcAsync(MachineId); if (r != null) RecipeSteps = r.Steps.OrderBy(s => s.StepNumber).ToList(); } catch { }
    }

    private bool IsDryerMachine() => Status?.MakineTipi?.Contains("Kurutma", StringComparison.OrdinalIgnoreCase) ?? false;
    private int GetTemperaturePercentage() => (int)Math.Min(100, ((IsDryerMachine() ? (double)Status!.AnlikSicaklik / 100.0 : (double)Status!.AnlikSicaklik / 10.0) / 150.0) * 100);
    private string GetFormattedTemperature() => IsDryerMachine() ? (Status!.AnlikSicaklik / 100.0m).ToString("F1") : (Status!.AnlikSicaklik / 10.0m).ToString("F1");
    private string GetConnectionCssClass() => Status?.ConnectionState == ConnectionStatus.Connected ? "bg-success" : "bg-danger";
    private string GetStatusText()
    {
        if (Status == null || Status.ConnectionState != ConnectionStatus.Connected) return Loc["BaglantiYok"];
        if (Status.HasActiveAlarm) return Loc["Alarm"];
        return Status.IsInRecipeMode ? Loc["Calisiyor"] : Loc["HazirDuruyor"];
    }
    private string GetStepTypeName(ScadaRecipeStep step)
    {
        var types = new List<string>();
        short w = (step.StepDataWords != null && step.StepDataWords.Length > 24) ? step.StepDataWords[24] : (short)0;
        if ((w & 1) != 0) types.Add(Loc["AdimTipi_SuAlma"]);
        if ((w & 2) != 0) types.Add(Loc["AdimTipi_Isitma"]);
        if ((w & 4) != 0) types.Add(Loc["AdimTipi_Calisma"]);
        if ((w & 8) != 0) types.Add(Loc["AdimTipi_Dozaj"]);
        if ((w & 16) != 0) types.Add(Loc["AdimTipi_Bosaltma"]);
        if ((w & 32) != 0) types.Add(Loc["AdimTipi_Sikma"]);
        return types.Any() ? string.Join(" + ", types) : "";
    }
    public void Dispose() { ScadaDataService.OnDataUpdated -= HandleDataUpdate; }
}