@page "/reports/production-detail/{MachineId:int}/{BatchId}"
@rendermode InteractiveServer
@using System.Text.Json
@using TekstilScada.Repositories
@using TekstilScada.Core.Models
@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Text.Json.Serialization
@inject ScadaDataService ScadaDataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["UretimDetayiBaslik"] - @BatchId</PageTitle>

@if (isLoading)
{
    <div class="d-flex flex-column justify-content-center align-items-center" style="height: 400px;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">@Loc["Yukleniyor"]</span>
        </div>
        <p class="mt-3 text-muted">@statusMessage</p>
    </div>
}
else if (detailData == null)
{
    <div class="alert alert-danger text-center shadow-sm mx-3 mt-4">
        <i class="oi oi-warning me-2"></i> @Loc["UretimDetayiBulunamadi"]
    </div>
}
else
{
    <div class="production-detail-container container-fluid pb-5 pt-3">
        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <h1 class="h3 text-dark mb-0">@Loc["UretimDetayRaporuBaslik"] <span class="text-primary">#@detailData.Header.BatchId</span></h1>
            <button class="btn btn-outline-success shadow-sm" @onclick="ExportToExcel" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    @Loc["Hazirlaniyor"]
                }
                else
                {
                    <i class="oi oi-data-transfer-download me-1"></i>
                    @Loc["ExceleAktar"]
                }
            </button>
        </div>

        @* --- 1. GENEL BİLGİLER KARTI --- *@
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold py-2">
                <i class="oi oi-info me-2"></i> @Loc["GenelBilgiler"]
            </div>
            <div class="card-body bg-white">
                <div class="row g-3">
                    <div class="col-md-2 col-6">
                        <label class="text-muted small d-block">@Loc["MakineAdi"]</label>
                        <span class="fw-bold fs-6">@detailData.Header.MachineName</span>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="text-muted small d-block">@Loc["ReceteAdiLabel"]</label>
                        <span class="fw-bold fs-6">@detailData.Header.RecipeName</span>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="text-muted small d-block">@Loc["OperatorLabel"]</label>
                        <span class="fs-6">@detailData.Header.OperatorName</span>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="text-muted small d-block">@Loc["MusteriNoLabel"]</label>
                        <span class="fs-6">@detailData.Header.MusteriNo</span>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="text-muted small d-block">@Loc["SiparisNoLabel"]</label>
                        <span class="fs-6">@detailData.Header.SiparisNo</span>
                    </div>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="row g-3 align-items-center">
                    <div class="col-md-3 col-6">
                        <label class="text-muted small d-block">@Loc["BaslangicZamani"]</label>
                        <span class="text-success fw-bold"><i class="oi oi-play me-1"></i> @detailData.Header.StartTime.ToString("dd.MM.yyyy HH:mm:ss")</span>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="text-muted small d-block">@Loc["BitisZamani"]</label>
                        <span class="text-danger fw-bold"><i class="oi oi-media-stop me-1"></i> @detailData.Header.EndTime.ToString("dd.MM.yyyy HH:mm:ss")</span>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="text-muted small d-block">@Loc["ToplamSure"]</label>
                        <span class="badge bg-secondary px-3 py-2 fs-6">@detailData.Header.CycleTime</span>
                    </div>
                </div>
            </div>
        </div>

        @* --- 2. GRAFİKLER BÖLÜMÜ --- *@
        <div class="row mb-4">
            @* SOL: PROSES GRAFİKLERİ *@
            <div class="col-lg-9 col-md-12 mb-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header fw-bold bg-white border-bottom py-2">
                        <i class="oi oi-graph me-2"></i> @Loc["ProsesZamanCizgisiBaslik"]
                    </div>
                    <div class="card-body p-2 bg-light">
                        @if (trendDataPoints != null && trendDataPoints.Any())
                        {
                            <div id="tempChart" class="chart-container shadow-sm mb-2"></div>
                            <div id="levelChart" class="chart-container shadow-sm mb-2"></div>
                            <div id="rpmChart" class="chart-container shadow-sm"></div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center h-100 text-muted p-5 bg-white rounded shadow-sm">
                                <i class="oi oi-bar-chart me-2"></i> @Loc["ZamanCizgisiPlaceholder"]
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* SAĞ: SÜRE DAĞILIMI (PASTA) *@
            <div class="col-lg-3 col-md-12">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header fw-bold bg-white border-bottom py-2">
                        <i class="oi oi-pie-chart me-2"></i> @Loc["SureDagilimiBaslik"]
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center align-items-center bg-white">
                        <div id="pie-chart" style="height: 250px; width: 100%;"></div>

                        <div class="w-100 mt-2">
                            @foreach (var segment in pieChartSegments)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-1 p-2 rounded bg-light border-start border-4"
                                     style="border-color: @segment.Color !important;">
                                    <span class="fw-bold" style="font-size: 0.85rem;">@segment.Label</span>
                                    <span class="badge bg-white text-dark border shadow-xs">@segment.Duration</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* --- 3. TABLOLAR --- *@
        <div class="row">
            <div class="col-lg-6 col-md-12 mb-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header fw-bold bg-white border-bottom py-2">
                        <i class="oi oi-list me-2 text-primary"></i> @Loc["AdimDetaylariBaslik"]
                    </div>
                    <div class="card-body p-0" style="max-height: 450px; overflow-y: auto;">
                        <table class="table table-hover table-striped mb-0 table-sm align-middle">
                            <thead class="sticky-top bg-light">
                                <tr>
                                    <th class="ps-3 py-2">#</th>
                                    <th>@Loc["AciklamaSutun"]</th>
                                    <th>@Loc["TeorikSure"]</th>
                                    <th>@Loc["GerceklesenSure"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in detailData.Steps)
                                {
                                    <tr style="@GetStepDurationStyle(step)">
                                        <td class="ps-3 fw-bold">@step.StepNumber</td>
                                        <td>@step.StepDescription</td>
                                        <td>@TimeSpan.FromSeconds(step.TheoreticalDurationSeconds).ToString(@"hh\:mm\:ss")</td>
                                        <td>@step.WorkingTime</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-12 mb-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header fw-bold bg-white border-bottom py-2 text-danger">
                        <i class="oi oi-bell me-2"></i> @Loc["AlarmGecmisiBaslik"]
                    </div>
                    <div class="card-body p-0" style="max-height: 450px; overflow-y: auto;">
                        @if (detailData.Alarms.Any())
                        {
                            <table class="table table-hover mb-0 table-sm align-middle">
                                <thead class="sticky-top bg-light">
                                    <tr>
                                        <th class="ps-3 py-2">@Loc["Saat"]</th>
                                        <th>@Loc["AciklamaSutun"]</th>
                                        <th class="text-end pe-3">@Loc["Sure"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alarm in detailData.Alarms)
                                    {
                                        <tr>
                                            <td class="ps-3">@alarm.AlarmTime.ToString("HH:mm:ss")</td>
                                            <td>@alarm.AlarmDescription</td>
                                            <td class="text-end pe-3 fw-bold">@alarm.Duration.ToString(@"hh\:mm\:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center p-5 text-muted">
                                <i class="oi oi-circle-check fs-1 text-success mb-3"></i>
                                <p>@Loc["AlarmYokMesaj"]</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .chart-container {
        background: white;
        border-radius: 8px;
        padding: 10px;
        height: 200px;
        width: 100%;
    }

    .shadow-xs {
        shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    .badge {
        font-weight: 500;
    }

    .info-kpi {
        border-radius: 8px;
        background: #f8f9fa;
    }
</style>

@code {
    [Parameter] public int MachineId { get; set; }
    [Parameter] public string BatchId { get; set; } = string.Empty;

    private ProductionDetailDto? detailData;
    private bool isLoading = true;
    private bool isExporting = false;
    private string statusMessage = "";

    private List<PieChartSegment> pieChartSegments = new();
    private List<TrendProcessDataPoint>? trendDataPoints;

    private bool shouldRenderTrendChart = false;
    private bool shouldRenderPieChart = false;
    private bool _chartsDrawn = false;

    // --- DİNAMİK LİMİTLER ---
    private int _maxTemp = 100;
    private int _maxWater = 100;

    private class PieChartSegment
    {
        public string Label { get; set; } = "";
        public string Color { get; set; } = "";
        public TimeSpan DurationTimeSpan { get; set; }
        public string Duration => $"{(int)DurationTimeSpan.TotalHours:D2}:{DurationTimeSpan.Minutes:D2}:{DurationTimeSpan.Seconds:D2}";
    }

    private class TrendProcessDataPoint
    {
        public DateTime Timestamp { get; set; }
        public decimal Temperature { get; set; }
        public decimal WaterLevel { get; set; }
        public int Rpm { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (MachineId == 0 || string.IsNullOrEmpty(BatchId))
        {
            isLoading = false;
            return;
        }

        try
        {
            // 🚨 DÜZELTME 1: Cache mekanizmasının doldurulmasını garanti altına alıyoruz
            await ScadaDataService.GetMachinesAsync();

            detailData = await ScadaDataService.GetProductionDetailAsync(MachineId, BatchId);

            if (detailData != null)
            {
                // Trend Raporunu Batch saatlerine göre çek
                await GenerateTrendReport();

                // Pasta Grafiği "Interval Merging" mantığıyla hesapla
                CalculatePieChartEfficiency();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // 📁 ProductionDetail.razor içindeki OnAfterRenderAsync metodunu bu şekilde güncelleyin:
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderPieChart && !_chartsDrawn)
        {
            var chartData = pieChartSegments.Select(s => new { label = s.Label, value = s.DurationTimeSpan.TotalSeconds, color = s.Color }).ToList();
            await JSRuntime.InvokeVoidAsync("drawPieChart", "pie-chart", chartData);
            _chartsDrawn = true;
            shouldRenderPieChart = false;
        }

        if (shouldRenderTrendChart && trendDataPoints != null && detailData != null)
        {
            shouldRenderTrendChart = false;

            string startISO = detailData.Header.StartTime.ToString("yyyy-MM-dd HH:mm:ss");
            DateTime effectiveEnd = detailData.Header.EndTime == DateTime.MinValue ? DateTime.Now : detailData.Header.EndTime;
            string endISO = effectiveEnd.ToString("yyyy-MM-dd HH:mm:ss");

            // 🚨 DÜZELTME: "plotDynamicDetailCharts" yerine JS dosyanızdaki gerçek ismi ("plotSyncedChartsWithLimits") geri yazdık
            await JSRuntime.InvokeVoidAsync("plotSyncedChartsWithLimits", trendDataPoints, startISO, endISO);
        }
    }

    private void CalculatePieChartEfficiency()
    {
        if (detailData == null || detailData.Alarms == null) return;

        pieChartSegments.Clear();
        DateTime batchStart = detailData.Header.StartTime;
        DateTime batchEnd = detailData.Header.EndTime;

        if (batchEnd <= batchStart) batchEnd = DateTime.Now;

        double totalBatchSeconds = (batchEnd - batchStart).TotalSeconds;
        if (totalBatchSeconds <= 0) return;

        var machineAlarms = detailData.Alarms.Where(a => a.AlarmNumber >= 0 && a.AlarmNumber <= 499).ToList();
        var operatorAlarms = detailData.Alarms.Where(a => a.AlarmNumber >= 500 && a.AlarmNumber <= 600).ToList();

        double netMachineSec = CalculateNetDurationInsideBatch(machineAlarms, batchStart, batchEnd);
        double netOperatorSec = CalculateNetDurationInsideBatch(operatorAlarms, batchStart, batchEnd);
        double totalDowntimeSec = CalculateNetDurationInsideBatch(detailData.Alarms, batchStart, batchEnd);

        double activeWorkingSec = totalBatchSeconds - totalDowntimeSec;
        if (activeWorkingSec < 0) activeWorkingSec = 0;

        pieChartSegments.Add(new PieChartSegment { Label = Loc["AktifCalisma"], Color = "#2ecc71", DurationTimeSpan = TimeSpan.FromSeconds(activeWorkingSec) });
        pieChartSegments.Add(new PieChartSegment { Label = Loc["MakineAlarm"], Color = "#e74c3c", DurationTimeSpan = TimeSpan.FromSeconds(netMachineSec) });
        pieChartSegments.Add(new PieChartSegment { Label = Loc["OperatorDuraklama"], Color = "#f39c12", DurationTimeSpan = TimeSpan.FromSeconds(netOperatorSec) });

        shouldRenderPieChart = true;
    }

    private double CalculateNetDurationInsideBatch(List<AlarmDetailDto> alarms, DateTime bStart, DateTime bEnd)
    {
        if (alarms == null || !alarms.Any()) return 0;

        var intervals = alarms
            .Select(a =>
            {
                DateTime aEnd = a.AlarmTime.Add(a.Duration);
                DateTime start = a.AlarmTime < bStart ? bStart : a.AlarmTime;
                DateTime end = aEnd > bEnd ? bEnd : aEnd;
                return new { start, end };
            })
            .Where(i => i.start < i.end)
            .OrderBy(i => i.start)
            .ToList();

        if (!intervals.Any()) return 0;

        double totalSec = 0;
        DateTime currentStart = intervals[0].start;
        DateTime currentEnd = intervals[0].end;

        for (int i = 1; i < intervals.Count; i++)
        {
            if (intervals[i].start < currentEnd)
            {
                if (intervals[i].end > currentEnd) currentEnd = intervals[i].end;
            }
            else
            {
                totalSec += (currentEnd - currentStart).TotalSeconds;
                currentStart = intervals[i].start;
                currentEnd = intervals[i].end;
            }
        }
        totalSec += (currentEnd - currentStart).TotalSeconds;
        return totalSec;
    }

    // 🚨 DÜZELTME 2: Kurutma Makinesi tanıma kuralı (Database Cache Esaslı)
    private bool IsDryerMachine()
    {
        if (ScadaDataService.MachineDetailsCache.TryGetValue(MachineId, out var dbMachine))
        {
            return dbMachine.MachineType == "Kurutma Makinesi";
        }
        return false;
    }

    // 🚨 DÜZELTME 3: Geçmiş trend verileri çekilip deserialize edilirken kurutma bölme kuralı uygulandı
    private async Task GenerateTrendReport()
    {
        if (detailData == null) return;
        var filter = new ReportFilters { StartTime = detailData.Header.StartTime, EndTime = detailData.Header.EndTime, MachineId = MachineId };
        var rawData = await ScadaDataService.GetTrendDataAsync(filter);
        if (rawData != null)
        {
            var json = JsonSerializer.Serialize(rawData);
            var deserialized = JsonSerializer.Deserialize<List<TrendProcessDataPoint>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            bool isDry = IsDryerMachine();
            trendDataPoints = deserialized?.Select(d => new TrendProcessDataPoint
            {
                Timestamp = d.Timestamp,
                Temperature = isDry ? d.Temperature / 10.0m : d.Temperature / 10.0m, // 100 vs 10 ayrımı sağlandı
                WaterLevel = d.WaterLevel,
                Rpm = d.Rpm
            }).ToList();

            shouldRenderTrendChart = true;
        }
    }

    private string GetStepDurationStyle(ProductionStepDetailDto step)
    {
        if (TimeSpan.TryParse(step.WorkingTime, out TimeSpan workingTime) && step.TheoreticalDurationSeconds > 0)
        {
            double diff = workingTime.TotalSeconds - step.TheoreticalDurationSeconds;
            if (diff > 60) return "background-color: rgba(231, 76, 60, 0.05); color: #c0392b;";
            if (diff < -60) return "background-color: rgba(46, 204, 113, 0.05); color: #27ae60;";
        }
        return "";
    }

    private async Task ExportToExcel()
    {
        isExporting = true;
        try
        {
            var bytes = await ScadaDataService.ExportProductionDetailFileAsync(MachineId, BatchId);
            if (bytes.Any()) await JSRuntime.InvokeVoidAsync("saveAsFile", $"Batch_{BatchId}_Report.xlsx", Convert.ToBase64String(bytes));
        }
        finally { isExporting = false; }
    }

    public void Dispose() { }
}