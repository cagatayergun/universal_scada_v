@page "/proses-izleme"

@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.WebApp.Components.Shared
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Threading
@using System.Globalization
@inject ScadaDataService ScadaDataService
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* 1. Detay Modalını Sayfaya Ekle *@
<MachineQuickDetailModal @bind-Show="showDetailModal"
                         MachineId="selectedMachineId"
                         OnClose="HandleModalClose" />

<PageTitle>@Loc["GenelBakis"]</PageTitle>

<h1>@Loc["GenelMakineDurumu"]</h1>

@* --- DEĞİŞİKLİK 1: Sabit Listeyi Kontrol Et --- *@
@if (AllMachines.Count == 0)
{
    <div class="d-flex justify-center align-center" style="height:200px">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
        <p class="ml-3">@Loc["VerilerYukleniyor"]</p>
    </div>
}
else
{
    <div class="machine-grid">
        @* --- DEĞİŞİKLİK 2: Local Listeyi Döngüye Al --- *@
        @foreach (var machineStatus in AllMachines.OrderBy(m => m.MachineId))
        {
            <MachineCard MachineStatus="machineStatus"
                         @key="machineStatus.MachineId"
                         @onclick="() => NavigateToDetail(machineStatus.MachineId)"
                         OnInfoClickAction="(id) => HandleInfoClickAction(id)" />
        }
    </div>
}

@code {
    private bool showDetailModal = false;
    private int selectedMachineId = 0;

    // Timer ve Veri Listesi
    private Timer _refreshTimer;
    private List<FullMachineStatus> AllMachines = new();
    private bool _isDisposed = false;
    private CultureInfo _userCulture;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userCulture = CultureInfo.CurrentUICulture;

            // 1. Servisi Başlat
            await ScadaDataService.InitializeAsync();

            // 2. Statik Listeyi Çek (Eksik makineleri tamamlamak için şart)
            await ScadaDataService.GetMachinesAsync();

            // --- ESKİ YÖNTEMİ İPTAL ET ---
            // ScadaDataService.OnDataUpdated += OnDataUpdatedHandler;

            // --- YENİ YÖNTEM: Timer Başlat (5 sn) ---
            _refreshTimer = new Timer(async _ =>
            {
                await InvokeAsync(OnTimerTick);
            }, null, 1000, 5000);

            // İlk açılışta verileri hemen doldur
            UpdateMachineData();
        }
        catch (Exception ex)
        {
            // Hata loglama
        }
    }

    // --- YENİ VERİ BİRLEŞTİRME MANTIĞI ---
    private void UpdateMachineData()
    {
        // 1. Veritabanındaki tüm makineleri al
        var definedMachines = ScadaDataService.MachineDetailsCache.Values.ToList();
        var tempList = new List<FullMachineStatus>();

        foreach (var defMachine in definedMachines)
        {
            // 2. Canlı verisi var mı kontrol et
            if (ScadaDataService.MachineData.TryGetValue(defMachine.Id, out var liveStatus))
            {
                // Varsa kullan (Tip bilgisi eksikse tamamla)
                if (string.IsNullOrEmpty(liveStatus.MakineTipi))
                    liveStatus.MakineTipi = defMachine.MachineSubType;

                tempList.Add(liveStatus);
            }
            else
            {
                // 3. Yoksa "Offline" kart oluştur
                tempList.Add(new FullMachineStatus
                {
                    MachineId = defMachine.Id,
                    MachineName = defMachine.MachineName,
                    MakineTipi = defMachine.MachineSubType,
                    ConnectionState = ConnectionStatus.Disconnected,
                    IsInRecipeMode = false,
                    HasActiveAlarm = false
                });
            }
        }

        // Listeyi güncelle
        AllMachines = tempList;
    }

    private void OnTimerTick()
    {
        if (_isDisposed) return;

        // Dil ayarını koru (Thread değiştiği için)
        if (_userCulture != null)
        {
            CultureInfo.CurrentCulture = _userCulture;
            CultureInfo.CurrentUICulture = _userCulture;
        }

        UpdateMachineData();
        StateHasChanged();
    }

    private void HandleInfoClickAction(int machineId)
    {
        selectedMachineId = machineId;
        showDetailModal = true;
        // Modal açıldığında anlık zorla yenileme yapılabilir
        StateHasChanged();
    }

    private Task HandleModalClose()
    {
        showDetailModal = false;
        selectedMachineId = 0;
        return Task.CompletedTask;
    }

    private void NavigateToDetail(int machineId)
    {
        NavManager.NavigateTo($"/proseskontrol/{machineId}");
    }

    public void Dispose()
    {
        _isDisposed = true;
        _refreshTimer?.Dispose();

        // Eski koddan kalan event varsa çıkar
        if (ScadaDataService != null)
        {
            // ScadaDataService.OnDataUpdated -= OnDataUpdatedHandler;
        }
    }
}