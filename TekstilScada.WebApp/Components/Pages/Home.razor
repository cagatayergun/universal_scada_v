@page "/proses-izleme"

@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.WebApp.Components.Shared
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Threading
@using System.Globalization
@inject ScadaDataService ScadaDataService
@inject FactoryStateService StateService
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* 1. Detay Modalını Sayfaya Ekle *@
<MachineQuickDetailModal @bind-Show="showDetailModal"
                         MachineId="selectedMachineId"
                         OnClose="HandleModalClose" />

<PageTitle>@Loc["GenelBakis"]</PageTitle>

<h1>@Loc["GenelMakineDurumu"]</h1>

@if (AllMachines.Count == 0)
{
    <div class="d-flex justify-center align-center" style="height:200px">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
        <p class="ml-3">@Loc["VerilerYukleniyor"]</p>
    </div>
}
else
{
    <div class="machine-grid">
        @foreach (var machineStatus in AllMachines.OrderBy(m => m.MachineId))
        {
            <MachineCard MachineStatus="machineStatus"
                         @key="machineStatus.MachineId"
                         @onclick="() => NavigateToDetail(machineStatus.MachineId)"
                         OnInfoClickAction="(id) => HandleInfoClickAction(id)" />
        }
    </div>
}

@code {
    private bool showDetailModal = false;
    private int selectedMachineId = 0;

    // Veri Listesi
    private List<FullMachineStatus> AllMachines = new();
    private CultureInfo _userCulture;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userCulture = CultureInfo.CurrentUICulture;

            // 1. Servise Abone Ol (Timer yerine Event)
            StateService.OnChange += HandleDataUpdate;

            // 2. İlk Verileri Çek
            HandleDataUpdate();
        }
        catch (Exception ex)
        {
            // Hata loglama
        }
    }

    // FactoryStateService tetiklediğinde çalışır
    private void HandleDataUpdate()
    {
        InvokeAsync(() =>
        {
            UpdateMachineData();
            StateHasChanged();
        });
    }

    private void UpdateMachineData()
    {
        // RAM'deki (Cache) tüm fabrika paketlerini tek bir listeye indiriyoruz.
        var tempList = new List<FullMachineStatus>();

        foreach (var machineList in StateService.FactoryDataCache.Values)
        {
            tempList.AddRange(machineList);
        }

        // Listeyi güncelle
        AllMachines = tempList;
    }

    private void HandleInfoClickAction(int machineId)
    {
        selectedMachineId = machineId;
        showDetailModal = true;
        StateHasChanged();
    }

    private Task HandleModalClose()
    {
        showDetailModal = false;
        selectedMachineId = 0;
        return Task.CompletedTask;
    }

    private void NavigateToDetail(int machineId)
    {
        NavManager.NavigateTo($"/proseskontrol/{machineId}");
    }

    public void Dispose()
    {
        // Sayfadan çıkıldığında aboneliği iptal et
        StateService.OnChange -= HandleDataUpdate;
    }
}