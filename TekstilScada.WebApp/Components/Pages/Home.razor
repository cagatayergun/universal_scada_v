@page "/proses-izleme"

@using TekstilScada.Models
@using TekstilScada.Core.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.WebApp.Components.Shared
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Threading
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client

@inject ScadaDataService ScadaService
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* Detay Modalı *@
<MachineQuickDetailModal @bind-Show="showDetailModal"
                         MachineId="selectedMachineId"
                         OnClose="HandleModalClose" />

<PageTitle>@Loc["GenelBakis"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Loc["GenelMakineDurumu"]</h1>

    @* Manuel Yenileme Butonu (Acil durumlar için) *@
    <button class="btn btn-outline-primary btn-sm" @onclick="ForceRefresh">
        <i class="bi bi-arrow-clockwise"></i> @Loc["Yenile"]
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height:300px; flex-direction:column;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">@Loc["VerilerYukleniyor"]</p>
    </div>
}
else if (AllMachines.Count == 0)
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @Loc["MakineBulunamadi"]
    </div>
}
else
{
    <div class="machine-grid">
        @* DEĞİŞİKLİK 1: Buradaki .OrderBy(m => m.MachineId) zorlamasını kaldırdık.
           Çünkü listeyi UpdateMachineData metodunda çoktan sıralamış olacağız. *@
        @foreach (var machineStatus in AllMachines)
        {
            <MachineCard MachineStatus="machineStatus"
                         @key="machineStatus.MachineId"
                         @onclick="() => NavigateToDetail(machineStatus.MachineId)"
                         OnInfoClickAction="(id) => HandleInfoClickAction(id)" />
        }
    </div>
}

@code {
    private bool showDetailModal = false;
    private int selectedMachineId = 0;
    private bool isLoading = true;
    private bool _isDisposed = false;
    
    // Veri Listesi
    private List<FullMachineStatus> AllMachines = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Event'e Abone Ol
            ScadaService.OnDataUpdated += HandleDataUpdate;

            // 2. İlk Verileri Hemen Çek (Beklemeden)
            await LoadInitialData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Prosesİzleme Init Hatası: {ex.Message}");
        }
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await ScadaService.GetMachinesAsync();
            var liveStatuses = await ScadaService.GetLiveMachineStatusByFactoryId(0);

            if (liveStatuses != null && liveStatuses.Any())
            {
                foreach (var status in liveStatuses)
                {
                    // DÜZELTME 1: Dictionary'nin Key değeri DisplayOrder değil MachineId olmak ZORUNDADIR!
                    ScadaService.MachineData[status.MachineId] = status;
                }
            }

            UpdateMachineData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Data Upload Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            // EĞER SAYFA HALA AÇIKSA ARAYÜZÜ GÜNCELLE
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        }
    }

    // ScadaService tetiklediğinde çalışır (Canlı Veri Geldiğinde)
    private void HandleDataUpdate()
    {
        // Sayfa kapandıysa hiç Invoke işlemine girip CPU'yu yorma
        if (_isDisposed) return;

        InvokeAsync(() =>
        {
            if (_isDisposed) return; // Çift güvenlik kontrolü
            UpdateMachineData();
            StateHasChanged();
        });
    }

    private void UpdateMachineData()
    {
        var tempList = new List<FullMachineStatus>();

        // DEĞİŞİKLİK 2: Önce listeyi tamamen oluşturuyoruz, ardından FullMachineStatus nesnesinin
        // kendi içindeki "DisplayOrder" değerine göre en son aşamada sıralıyoruz.
        foreach (var m in ScadaService.MachineDetailsCache.Values)
        {
            if (ScadaService.MachineData.TryGetValue(m.Id, out var liveStatus))
            {
                // Eğer canlı veride makine tipi boş geldiyse, tanımdan (Cache) doldur
                if (string.IsNullOrEmpty(liveStatus.MakineTipi))
                    liveStatus.MakineTipi = m.MachineSubType;
                    
                // Güvenlik: Eğer canlı veriden DisplayOrder 0 gelirse, veritabanı cache'inden tamamla
                if (liveStatus.DisplayOrder <= 0 && m.DisplayOrder > 0)
                    liveStatus.DisplayOrder = m.DisplayOrder;

                tempList.Add(liveStatus);
            }
            else
            {
                // O an canlı verisi (SignalR vb.) yoksa varsayılan Offline kart oluştur
                tempList.Add(new FullMachineStatus
                {
                    MachineId = m.Id,
                    MachineName = m.MachineName,
                    MakineTipi = string.IsNullOrEmpty(m.MachineSubType) ? "Undefined" : m.MachineSubType,
                    ConnectionState = ConnectionStatus.Disconnected,
                    DisplayOrder = m.DisplayOrder, // Çevrimdışı olsa bile sıralama yerini korusun
                    manuel_status = false
                });
            }
        }

        // 3. OLUŞAN NİHAİ LİSTEYİ SIRALA
        // Sıfır (0) veya eksi girilmişse en sona (999999) atıyoruz, ardından Id'ye göre sıralıyoruz.
        AllMachines = tempList
            .OrderBy(x => x.DisplayOrder <= 0 ? 999999 : x.DisplayOrder)
            .ThenBy(x => x.MachineId)
            .ToList();
    }

    private async Task ForceRefresh()
    {
        await LoadInitialData();
    }

    private void HandleInfoClickAction(int machineId)
    {
        selectedMachineId = machineId;
        showDetailModal = true;
    }

    private void HandleModalClose()
    {
        showDetailModal = false;
        selectedMachineId = 0;
    }

    private void NavigateToDetail(int machineId)
    {
        NavManager.NavigateTo($"/proseskontrol/{machineId}");
    }

    public void Dispose()
    {
        _isDisposed = true; // Sayfanın kapandığını sisteme bildir
        if (ScadaService != null)
        {
            ScadaService.OnDataUpdated -= HandleDataUpdate;
        }
    }
}