@page "/proses-izleme"

@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.WebApp.Components.Shared
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Threading
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client
@* DOĞRU SERVİSLERİ KULLANIYORUZ *@
@inject ScadaDataService ScadaService
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* 1. Detay Modalı *@
<MachineQuickDetailModal @bind-Show="showDetailModal"
                         MachineId="selectedMachineId"
                         OnClose="HandleModalClose" />

<PageTitle>@Loc["GenelBakis"]</PageTitle>

<h1>@Loc["GenelMakineDurumu"]</h1>

@if (AllMachines.Count == 0)
{
    <div class="d-flex justify-center align-center" style="height:200px; flex-direction:column;">
        @if (ScadaService.HubConnection?.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
        {
            <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
            <p class="ml-3 mt-2">@Loc["VerilerYukleniyor"]</p>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.WifiOff" Size="Size.Large" Color="Color.Error" />
            <p class="ml-3 mt-2">Bağlantı bekleniyor...</p>
        }
    </div>
}
else
{
    <div class="machine-grid">
        @foreach (var machineStatus in AllMachines.OrderBy(m => m.MachineId))
        {
            <MachineCard MachineStatus="machineStatus"
                         @key="machineStatus.MachineId"
                         @onclick="() => NavigateToDetail(machineStatus.MachineId)"
                         OnInfoClickAction="(id) => HandleInfoClickAction(id)" />
        }
    </div>
}

@code {
    private bool showDetailModal = false;
    private int selectedMachineId = 0;

    // Veri Listesi
    private List<FullMachineStatus> AllMachines = new();
    private CultureInfo _userCulture;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userCulture = CultureInfo.CurrentUICulture;

            // 1. DOĞRU SERVİSE ABONE OL (StateService DEĞİL, ScadaService)
            ScadaService.OnDataUpdated += HandleDataUpdate;

            // 2. İlk Verileri Çek
            // Eğer veri boşsa ve bağlantı varsa, veri gelmesini bekle veya manuel tetikle
            if (ScadaService.MachineData.IsEmpty && ScadaService.HubConnection?.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
            {
                // Gerekirse: await ScadaService.GetMachinesAsync(0);
            }

            HandleDataUpdate();
        }
        catch (Exception ex)
        {
            // Hata loglama
            Console.WriteLine($"Prosesİzleme Hatası: {ex.Message}");
        }
    }

    // ScadaService tetiklediğinde çalışır
    private void HandleDataUpdate()
    {
        InvokeAsync(() =>
        {
            UpdateMachineData();
            StateHasChanged();
        });
    }

    private void UpdateMachineData()
    {
        // --- DEĞİŞİKLİK: ScadaService.MachineData KULLANILIYOR ---
        // Bu liste sadece giriş yapılan (seçilen) fabrikanın verilerini içerir.
        // Fabrika A kullanıcısı Fabrika B verisini ASLA göremez.

        AllMachines = ScadaService.MachineData.Values.ToList();
    }

    private void HandleInfoClickAction(int machineId)
    {
        selectedMachineId = machineId;
        showDetailModal = true;
        StateHasChanged();
    }

    private Task HandleModalClose()
    {
        showDetailModal = false;
        selectedMachineId = 0;
        return Task.CompletedTask;
    }

    private void NavigateToDetail(int machineId)
    {
        NavManager.NavigateTo($"/proseskontrol/{machineId}");
    }

    public void Dispose()
    {
        // Sayfadan çıkıldığında aboneliği iptal et
        if (ScadaService != null)
        {
            ScadaService.OnDataUpdated -= HandleDataUpdate;
        }
    }
}