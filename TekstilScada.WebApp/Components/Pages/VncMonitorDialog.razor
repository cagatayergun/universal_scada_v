@page "/vnc-monitor/{MachineId:int}"
@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Microsoft.AspNetCore.SignalR.Client
@inject ScadaDataService ScadaService
@inject VncSessionService VncSessionService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Class="mr-3 mb-n1" />
            @if (machine != null)
            {
                @($"{Loc["UzaktanErisim"]} - {machine.MachineName} ")
            }
            else
            {
                @Loc["UzaktanErisim"]
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isAccessDenied)
        {
            <MudAlert Severity="Severity.Warning">
                Erişim Reddedildi!
                Şu an başka bir operatör (@currentViewerName) bu makineyi izliyor.
            </MudAlert>
        }
        else if (machine == null)
        {
            <div class="d-flex flex-column justify-center align-center py-8" style="height: 300px;">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="mt-4">Loading machine data...</MudText>
            </div>
        }
        else
        {
            @* --- GÖRÜNTÜ PANELİ (Tıklama Olayları Tamamen Kaldırıldı) --- *@
            <div style="width: 100%; min-height: 400px; display: flex; justify-content: center; align-items: center; background-color: #000; border: 1px solid #333; overflow: hidden;">
                @if (!string.IsNullOrEmpty(imageData))
                {
                    <img id="vncStreamImage"
                         src="data:image/jpeg;base64,@imageData"
                         style="max-width: 100%; max-height: 600px; object-fit: contain; cursor: default;"
                         draggable="false" />
                }
                else
                {
                    <div class="d-flex flex-column align-center">
                        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                        <MudText Class="mt-2" Typo="Typo.caption" Color="Color.Surface">Image awaited...</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity:0.5; font-size:10px;">(Gateway bağlantısı kontrol ediliyor)</MudText>
                    </div>
                }
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int MachineId { get; set; }

    // State Değişkenleri
    private Machine? machine;
    private bool isAccessDenied = false;
    private string? currentViewerName;
    private string myUserName = "Operator";
    private HubConnection? hubConnection;
    private string? imageData;

    // --- PERFORMANS VE DARBOĞAZ ENGELLEME DEĞİŞKENLERİ ---
    private bool _isProcessingFrame = false; // Kare işleme (Render) kilidi
    private DateTime _lastFrameTime = DateTime.MinValue; // Son kare kabul zamanı
    private const int MinimumFrameIntervalMs = 150; // İdeal kare aralığı (Hattı tıkamaz, akıcı görüntü sunar)

    private System.Threading.Timer? _heartbeatTimer;
    private DotNetObjectReference<VncMonitorDialog>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Makine Bilgisini Önbellekten / Servisten Çek
            var machines = await ScadaService.GetMachinesAsync();
            if (machines != null) machine = machines.FirstOrDefault(m => m.Id == MachineId);

            // 2. Oturum Kontrolü
            var result = VncSessionService.TryEnterSession(MachineId, myUserName);
            if (!result.Success)
            {
                isAccessDenied = true;
                currentViewerName = result.CurrentUser;
                return;
            }

            // 3. SignalR Canlı Resim Akışını Başlat
            await StartSignalRConnection();

            // 4. Sayfa Kapanma Hook'u
            _objRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("vncUtils.setupUnloadHandler", _objRef);
            }
            catch { }

            // 5. Gateway Keep-Alive Heartbeat
            _heartbeatTimer = new System.Threading.Timer(async _ => await SendHeartbeat(), null, 5000, 5000);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[VNC Init Error] {ex.Message}");
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var hubUrl = "https://api.yilmaktelemetry.com/scadaHub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult(token);
                })
                .WithAutomaticReconnect()
                .Build();

            // Sadece Akıllı Filtrelemeden Geçen Canlı Kareleri Kabul Eden Dinleyici
            hubConnection.On<int, string>("ReceiveScreenImage", (mId, base64) =>
            {
                if (mId == MachineId)
                {
                    var now = DateTime.UtcNow;

                    // Gecikme Birikmesini Önleyen Karar Mekanizması:
                    // Önceki kare render ediliyorsa veya son kareden sonra 150ms geçmediyse bu kareyi işleme, direkt atla!
                    if (_isProcessingFrame || (now - _lastFrameTime).TotalMilliseconds < MinimumFrameIntervalMs)
                    {
                        return;
                    }

                    _isProcessingFrame = true;
                    _lastFrameTime = now;

                    _ = InvokeAsync(async () =>
                    {
                        try
                        {
                            imageData = base64;
                            StateHasChanged(); // Sadece taze olan kareyi ekrana bas
                            await Task.Yield(); // Blazor Server WebSocket kanalına nefes aldır
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"VNC Render Hatası: {ex.Message}");
                        }
                        finally
                        {
                            _isProcessingFrame = false; // Yeni taze kareler için kilidi aç
                        }
                    });
                }
            });

            await hubConnection.StartAsync();

            if (machine != null)
            {
                string vncParams = $"{machine.VncAddress};{machine.VncPassword}";
                await hubConnection.InvokeAsync("SendCommandToLocal", ScadaService.CurrentFactoryId, MachineId, "START_VNC", vncParams);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR Error] {ex.Message}");
        }
    }

    private async Task SendHeartbeat()
    {
        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await hubConnection.InvokeAsync("SendCommandToLocal", ScadaService.CurrentFactoryId, MachineId, "HEARTBEAT", "");
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnPageUnload()
    {
        await DisposeAsync();
    }

    private void CloseConnection()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    public async ValueTask DisposeAsync()
    {
        if (_heartbeatTimer != null) await _heartbeatTimer.DisposeAsync();

        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await hubConnection.InvokeAsync("SendCommandToLocal", ScadaService.CurrentFactoryId, MachineId, "STOP_VNC", "");
            }
            catch { }
        }

        if (hubConnection is not null) await hubConnection.DisposeAsync();
        if (!isAccessDenied) VncSessionService.ExitSession(MachineId, myUserName);
        _objRef?.Dispose();
    }
}