@page "/vnc-monitor/{MachineId:int}"
@using TekstilScada.Models
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Microsoft.AspNetCore.SignalR.Client
@inject ScadaDataService ScadaService
@inject VncSessionService VncSessionService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Class="mr-3 mb-n1" />
            @if (machine != null)
            {
                @($"{Loc["UzaktanErisim"]} - {machine.MachineName}")
            }
            else
            {
                @Loc["UzaktanErisim"]
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isAccessDenied)
        {
            <MudAlert Severity="Severity.Warning">
                Erişim Reddedildi! Şu an başka bir operatör (@currentViewerName) bu makineyi izliyor.
            </MudAlert>
        }
        else if (machine == null)
        {
            <div class="d-flex flex-column justify-center align-center py-8" style="height: 300px;">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="mt-4">Makine bilgileri yükleniyor...</MudText>
            </div>
        }
        else
        {
            @* --- YENİ SİSTEM: SIGNALR GÖRÜNTÜ PANELİ --- *@
            <div style="width: 100%; min-height: 400px; display: flex; justify-content: center; align-items: center; background-color: #000; border: 1px solid #333;">
                @if (!string.IsNullOrEmpty(imageData))
                {
                    <img src="data:image/jpeg;base64,@imageData" style="max-width: 100%; max-height: 600px; object-fit: contain;" />
                }
                else
                {
                    <div class="d-flex flex-column align-center">
                        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                        <MudText Class="mt-2" Typo="Typo.caption" Color="Color.Surface">Görüntü Bekleniyor...</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity:0.5; font-size:10px;">(Gateway bağlantısı kontrol ediliyor)</MudText>
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseConnection" Color="Color.Error" Variant="Variant.Filled">Kapat</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int MachineId { get; set; }

    private Machine? machine;
    private bool isAccessDenied = false;
    private string? currentViewerName;
    private string myUserName = "Operator"; // Giriş yapan kullanıcının gerçek adı buraya gelmeli

    // SignalR Değişkenleri
    private HubConnection? hubConnection;
    private string? imageData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Makine Bilgisi
            var machines = await ScadaService.GetMachinesAsync();
            if (machines != null)
            {
                machine = machines.FirstOrDefault(m => m.Id == MachineId);
            }

            // 2. Kilit Kontrolü (Session Service)
            // Not: Gerçek kullanıcı adını AuthenticationStateProvider'dan almanız daha doğru olur.
            var result = VncSessionService.TryEnterSession(MachineId, myUserName);
            if (!result.Success)
            {
                isAccessDenied = true;
                currentViewerName = result.CurrentUser;
                return; // Erişim yoksa SignalR başlatma
            }

            // 3. SignalR Bağlantısını Başlat
            await StartSignalRConnection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[VNC Init Hatası] {ex.Message}");
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            // Token'ı LocalStorage'dan al
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            // Hub Adresini Appsettings veya NavigationManager'dan dinamik alabilirsiniz
            // Şimdilik API adresinizi elle veriyoruz (Production için ApiBaseUrl kullanılmalı)
            var hubUrl = "https://api.malkanteknolojionline.com.tr/scadaHub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult(token);
                })
                .WithAutomaticReconnect()
                .Build();

            // Gelen Resim Verisini Yakala
            hubConnection.On<int, string>("ReceiveScreenImage", (mId, base64) =>
            {
                // Sadece baktığımız makinenin verisi geldiyse ekranı güncelle
                if (mId == MachineId)
                {
                    imageData = base64;
                    InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR Bağlantı Hatası] {ex.Message}");
        }
    }

    private void CloseConnection()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    public async ValueTask DisposeAsync()
    {
        // 1. SignalR Bağlantısını Kes
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }

        // 2. Oturum Kilidini Kaldır
        if (!isAccessDenied)
        {
            VncSessionService.ExitSession(MachineId, myUserName);
        }
    }
}