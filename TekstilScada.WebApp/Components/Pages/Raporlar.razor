    private Func<ProductionReportItem, bool> _quickFilter => x => CheckFilter(x.MachineName, x.RecipeName, x.BatchId, x.OperatorName, x.SiparisNo, x.MusteriNo, _searchString);
    private Func<TekstilScada.Core.Models.ActionLogEntry, bool> _quickFilterAction => x => CheckFilter(x.Username, x.Details, x.ActionType, null, null, null, _searchStringAction);
    private Func<ProductionReportItem, bool> _quickFilterGeneral => x => CheckFilter(x.MachineName, x.BatchId, null, null, null, null, _searchStringGeneral);

    private bool CheckFilter(string s1, string s2, string s3, string s4, string s5, string s6, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;

        return (s1?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
               (s2?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
               (s3?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
               (s4?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
               (s5?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
               (s6?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task SaveProductionFilters()
    {
        var tasks = new List<Task>
        {
            LocalStorage.SetItemAsync("rep_prod_machine", selectedMachineId).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_start", _dateRange.Start).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_end", _dateRange.End).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_recipe", filters.RecipeName).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_batch", filters.BatchNo).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_siparis", filters.SiparisNo).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_musteri", filters.MusteriNo).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_operator", filters.OperatorName).AsTask(),
            LocalStorage.SetItemAsync("rep_prod_page", _currentPage).AsTask(),
            LocalStorage.SetItemAsync("rep_active_tab", "uretim").AsTask()
        };
        await Task.WhenAll(tasks);
    }

    private async Task LoadSavedFilters()
    {
        var savedTab = await LocalStorage.GetItemAsync<string>("rep_active_tab");
        if (!string.IsNullOrEmpty(savedTab)) activeTab = savedTab;

        if (activeTab == "uretim" && await LocalStorage.ContainKeyAsync("rep_prod_machine"))
        {
            selectedMachineId = await LocalStorage.GetItemAsync<int>("rep_prod_machine");
            var start = await LocalStorage.GetItemAsync<DateTime?>("rep_prod_start");
            var end = await LocalStorage.GetItemAsync<DateTime?>("rep_prod_end");
            if (start != null && end != null) _dateRange = new DateRange(start, end);

            filters.RecipeName = await LocalStorage.GetItemAsync<string>("rep_prod_recipe");
            filters.BatchNo = await LocalStorage.GetItemAsync<string>("rep_prod_batch");
            filters.SiparisNo = await LocalStorage.GetItemAsync<string>("rep_prod_siparis");
            filters.MusteriNo = await LocalStorage.GetItemAsync<string>("rep_prod_musteri");
            filters.OperatorName = await LocalStorage.GetItemAsync<string>("rep_prod_operator");

            bool isReturning = await LocalStorage.ContainKeyAsync("rep_return_from_detail");

            if (isReturning)
            {
                await LocalStorage.RemoveItemAsync("rep_return_from_detail");
                await GenerateReportCore(false);
                if (await LocalStorage.ContainKeyAsync("rep_prod_page"))
                {
                    _currentPage = await LocalStorage.GetItemAsync<int>("rep_prod_page");
                }
            }
        }
    }

