    private async Task GenerateManualConsumptionReport()
    {
        UpdateFiltersFromDateRanges();
        if (_selectedManualMachineIds == null || !_selectedManualMachineIds.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", Loc["LutfenEnAzBirMakineSeciniz"].Value);
            return;
        }

        isLoading = true;
        manualConsumptionReports = new List<ManualConsumptionSummary>();
        StateHasChanged(); // Sadece loading animasyonunu başlatmak için

        try
        {
            // İşleme başlamadan makine listesini O(1) arama hızına sahip Dictionary'ye alıyoruz
            var machineDict = machines?.ToDictionary(m => m.Id, m => m) ?? new Dictionary<int, Machine>();

            var fetchTasks = _selectedManualMachineIds.Select(async mId =>
            {
                var effectiveFilters = new ReportFilters { StartTime = manualFilters.StartTime.Date, EndTime = GetEndOfDay(manualFilters.EndTime), MachineId = mId };
                var summary = await ScadaDataService.GetManualConsumptionReportAsync(effectiveFilters);

                if (summary != null)
                {
                    // Dictionary üzerinden bekleme yapmadan thread-safe şekilde eşleştir
                    if (machineDict.TryGetValue(mId, out var machineInfo) && machineInfo.MachineType == "Kurutma Makinesi")
                    {
                        summary.ToplamSuTuketimi_Litre = 0;
                    }
                }
                return summary;
            });

            var results = await Task.WhenAll(fetchTasks);
            manualConsumptionReports = results.Where(r => r != null).ToList();
        
        }
        catch (Exception ex)
        {
            //Console.WriteLine($"Manuel Tüketim Hatası: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            // Blazor butona basılma olayı bittiğinde StateHasChanged'i kendisi çağırır, tekrar yazmaya gerek yok.
        }
    }

