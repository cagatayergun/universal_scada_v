@page "/raporlar"
@rendermode InteractiveServer
@using TekstilScada.Models
@using TekstilScada.Repositories
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject ScadaDataService ScadaDataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["GecmisAlarmlarTab"]</PageTitle>

<h1>@Loc["GecmisAlarmlarTab"]</h1>

<div class="card mt-4">
    <div class="card-body">
        
        <MudCard Class="mb-4" Elevation="3">
            <MudCardContent>
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    @* 1. Tarih Aralığı *@
                    <MudItem xs="12" md="5">
                        <MudDateRangePicker Label="@Loc["TarihAraligiLabel"]"
                                            @bind-DateRange="_alarmDateRange"
                                            Color="MudBlazor.Color.Primary"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense" />
                    </MudItem>

                    @* 2. Makine Seçimi *@
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" Label="@Loc["MakineLabel"]"
                                   @bind-Value="selectedAlarmMachineId"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="0">@Loc["TumMakineler"]</MudSelectItem>
                            @if (machines != null)
                            {
                                foreach (var m in machines)
                                {
                                    <MudSelectItem Value="@m.Id">@m.MachineName</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    @* 3. Butonlar *@
                    <MudItem xs="12" md="4" Class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="MudBlazor.Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ManageSearch"
                                   OnClick="OnAlarmReportButtonClick"
                                   Disabled="@isLoading">
                            @(isLoading ? Loc["Hesaplaniyor"].Value : Loc["RaporlaButon"].Value)
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="MudBlazor.Color.Success"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="ExportAlarmsToExcel"
                                   Disabled="@isLoading">
                            @Loc["ExcelIndirButon"]
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        @* Server-Side DataGrid *@
        <MudDataGrid T="AlarmReportItem"
                     ServerData="@AlarmServerReload"
                     @ref="_alarmDataGrid"
                     Filterable="false"
                     SortMode="SortMode.None"
                     Groupable="false"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     RowsPerPage="50">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Loc["AlarmGecmisiBaslikRaporlar"]</MudText>
                <MudSpacer />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.MachineName" Title="@Loc["MakineLabel"]" />
                <PropertyColumn Property="x => x.AlarmNumber" Title="@Loc["No"]" />
                <PropertyColumn Property="x => x.AlarmText" Title="@Loc["Aciklama"]" />
                <PropertyColumn Property="x => x.StartTime" Title="@Loc["BaslangicZamani"]" Format="dd.MM.yy HH:mm:ss" />

                <TemplateColumn Title="@Loc["BitisZamani"]">
                    <CellTemplate>
                        @if (context.Item.EndTime.HasValue)
                        {
                            @context.Item.EndTime.Value.ToString("dd.MM.yy HH:mm:ss")
                        }
                        else
                        {
                            <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Variant="Variant.Filled">@Loc["Aktif"]</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Duration" Title="@Loc["Sure"]" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="AlarmReportItem" PageSizeOptions="@(new int[] { 50, 100, 200 })" />
            </PagerContent>
        </MudDataGrid>

    </div>
</div>

@code {
    private List<Machine>? machines;
    private bool isLoading = false;

    // Alarm Filtreleri
    private DateRange _alarmDateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private int selectedAlarmMachineId = 0;
    private ReportFilters alarmFilters = new();

    // DataGrid Kontrolleri
    private bool _canLoadAlarmData = false;
    private MudDataGrid<AlarmReportItem> _alarmDataGrid;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // İlk açılışta makineleri getir
            machines = await ScadaDataService.GetMachinesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hata: {ex.Message}");
        }
    }

    // --- ALARM SERVER DATA RELOAD METODU ---
    private async Task<GridData<AlarmReportItem>> AlarmServerReload(GridState<AlarmReportItem> state)
    {
        // Eğer henüz butona basılmadıysa boş veri döndür
        if (!_canLoadAlarmData)
        {
            return new GridData<AlarmReportItem> { TotalItems = 0, Items = new List<AlarmReportItem>() };
        }

        UpdateAlarmFilters();

        // Sayfalama (Pagination) için sadece o sayfanın verisini çeker
        var pagedData = await ScadaDataService.GetAlarmReportPagedAsync(alarmFilters, state.Page, state.PageSize);

        return new GridData<AlarmReportItem>
        {
            TotalItems = pagedData.TotalCount,
            Items = pagedData.Items
        };
    }

    // --- BUTONA BASILINCA ÇALIŞACAK METOT ---
    private async Task OnAlarmReportButtonClick()
    {
        _canLoadAlarmData = true; // Artık veri çekmeye izin ver
        if (_alarmDataGrid != null)
        {
            await _alarmDataGrid.ReloadServerData(); // Grid'i tetikle
        }
    }

    // Filtreleri güncelleyen yardımcı metot
    private void UpdateAlarmFilters()
    {
        if (_alarmDateRange.Start.HasValue) alarmFilters.StartTime = _alarmDateRange.Start.Value;
        if (_alarmDateRange.End.HasValue) alarmFilters.EndTime = _alarmDateRange.End.Value.AddDays(1).AddTicks(-1);
        
        alarmFilters.MachineId = selectedAlarmMachineId == 0 ? (int?)null : selectedAlarmMachineId;
    }

    // --- EXCEL ÇIKTISI ALMA ---
    private async Task ExportAlarmsToExcel()
    {
        await ExportHelper(async () =>
        {
            UpdateAlarmFilters();
            // Export için o anki filtreye uyan TÜM veriyi (sayfalama olmadan) çekiyoruz
            var allAlarms = await ScadaDataService.GetAlarmReportAsync(alarmFilters);
            return await ScadaDataService.ExportAlarmReportAsync(allAlarms);
        }, "Alarm_Raporu");
    }

    // --- ORTAK EXCEL İNDİRME METODU ---
    private async Task ExportHelper(Func<Task<byte[]>> exportFunc, string fileNamePrefix)
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var excelBytes = await exportFunc();
            if (excelBytes != null && excelBytes.Length > 0)
            {
                await JSRuntime.InvokeVoidAsync("saveAsFile", $"{fileNamePrefix}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(excelBytes));
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", Loc["KriterlereUygunKayitYok"].Value);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Excel export hatası:", ex.ToString());
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}