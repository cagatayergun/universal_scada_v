    private void UpdateFiltersFromDateRanges()
    {
        if (_dateRange.Start.HasValue) filters.StartTime = _dateRange.Start.Value;
        if (_dateRange.End.HasValue) filters.EndTime = _dateRange.End.Value;
        if (_alarmDateRange.Start.HasValue) alarmFilters.StartTime = _alarmDateRange.Start.Value;
        if (_alarmDateRange.End.HasValue) alarmFilters.EndTime = _alarmDateRange.End.Value;
        if (_actionDateRange.Start.HasValue) actionLogFilters.StartTime = _actionDateRange.Start.Value;
        if (_actionDateRange.End.HasValue) actionLogFilters.EndTime = _actionDateRange.End.Value;
        if (_trendDateRange.Start.HasValue) trendFilters.StartTime = _trendDateRange.Start.Value;
        if (_trendDateRange.End.HasValue) trendFilters.EndTime = _trendDateRange.End.Value;
        if (_manualDateRange.Start.HasValue) manualFilters.StartTime = _manualDateRange.Start.Value;
        if (_manualDateRange.End.HasValue) manualFilters.EndTime = _manualDateRange.End.Value;
        if (_generalDateRange.Start.HasValue) generalConsumptionFilters.StartTime = _generalDateRange.Start.Value;
        if (_generalDateRange.End.HasValue) generalConsumptionFilters.EndTime = _generalDateRange.End.Value;
    }

    private async Task GenerateTrendReport()
    {
        UpdateFiltersFromDateRanges();
        if (selectedTrendMachineIdInt == 0) { await JSRuntime.InvokeVoidAsync("alert", Loc["LutfenMakineSeciniz"].Value); return; }

        isLoading = true;
        trendDataPoints = null;
        shouldRenderChart = false;
        StateHasChanged();

        try
        {
            var effectiveFilters = new ReportFilters { StartTime = trendFilters.StartTime.Date, EndTime = GetEndOfDay(trendFilters.EndTime), MachineId = selectedTrendMachineIdInt };
            var rawData = await ScadaDataService.GetTrendDataAsync(effectiveFilters);

            if (rawData != null)
            {
                // Tüm JSON dönüştürme, istatistik hesaplama ve GÖRSEL SEYRELTME işlemlerini arka plana atıyoruz (UI Donmaz!)
                var processedResult = await Task.Run(() =>
                {
                    List<TrendProcessDataPoint> fullData;

                    // 1. JSON Parse İşlemi
                    if (rawData.Count > 0 && rawData[0] is JsonElement)
                        fullData = rawData.Select(x => ((JsonElement)x).Deserialize<TrendProcessDataPoint>()).ToList();
                    else
                    {
                        var jsonString = JsonSerializer.Serialize(rawData);
                        fullData = JsonSerializer.Deserialize<List<TrendProcessDataPoint>>(jsonString);
                    }

                    if (fullData == null || !fullData.Any()) return null;

                    // 2. İstatistikleri HAM veri üzerinden (doğru sonuç için) hesapla
                    var temps = fullData.Select(x => x.Temperature / 10.0m).ToList();
                    var rpms = fullData.Select(x => x.Rpm).ToList();
                    var levels = fullData.Select(x => x.WaterLevel).ToList();

                    var stats = new TrendStats
                    {
                        MinTemp = temps.DefaultIfEmpty(0).Min(),
                        MaxTemp = temps.DefaultIfEmpty(0).Max(),
                        AvgTemp = temps.DefaultIfEmpty(0).Average(),
                        MinRpm = rpms.DefaultIfEmpty(0).Min(),
                        MaxRpm = rpms.DefaultIfEmpty(0).Max(),
                        AvgRpm = rpms.DefaultIfEmpty(0).Average(),
                        MinLevel = levels.DefaultIfEmpty(0).Min(),
                        MaxLevel = levels.DefaultIfEmpty(0).Max(),
                        AvgLevel = levels.DefaultIfEmpty(0).Average()
                    };

                    // 3. Grafiğe çizilecek veriyi SEYRELT (Downsampling)
                    const int TARGET_POINT_COUNT = 500;
                    List<TrendProcessDataPoint> pointsToDraw = fullData;

                    if (fullData.Count > TARGET_POINT_COUNT)
                    {
                        int groupSize = (int)Math.Ceiling((double)fullData.Count / TARGET_POINT_COUNT);
                        pointsToDraw = fullData
                            .Select((x, i) => new { Index = i, Value = x })
                            .GroupBy(x => x.Index / groupSize)
                            .Select(g => new TrendProcessDataPoint
                            {
                                Timestamp = g.First().Value.Timestamp,
                                Temperature = g.Average(p => p.Value.Temperature),
                                Rpm = (int)g.Average(p => p.Value.Rpm),
                                WaterLevel = g.Average(p => p.Value.WaterLevel)
                            })
                            .ToList();
                    }

                    // UI'a sadece özetlenmiş veriyi ve istatistikleri gönderiyoruz
                    return new { Stats = stats, PointsToDraw = pointsToDraw };
                });

                if (processedResult != null)
                {
                    trendStats = processedResult.Stats;
                    trendDataPoints = processedResult.PointsToDraw; // Artık RAM'de sadece 500 nokta tutulacak!
                    shouldRenderChart = true;
                }
            }
        }
        catch (Exception ex) { /* Loglama yapılabilir */ }
        finally { isLoading = false; StateHasChanged(); }
    }

   
