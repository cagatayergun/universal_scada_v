@page "/raporlar"
@rendermode InteractiveServer
@using TekstilScada.Models
@using TekstilScada.Repositories
@using TekstilScada.WebApp.Services
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Text.Json

@inject ScadaDataService ScadaDataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["RaporlarBaslik"]</PageTitle>

<h1>@Loc["RaporlarBaslik"]</h1>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link @(activeTab == "uretim" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("uretim")'>@Loc["UretimRaporuTab"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "alarmlar" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("alarmlar")'>@Loc["GecmisAlarmlarTab"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "verimlilik" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("verimlilik")'>Verimlilik ve Durum</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "trend" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("trend")'>@Loc["TrendAnaliziTabRaporlar"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "manuelTuketim" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("manuelTuketim")'>@Loc["ManuelTuketimTab"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "genelTuketim" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("genelTuketim")'>@Loc["GenelTuketimRaporuTab"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "eylemKayitlari" ? "active" : "")" href="javascript:void(0);" @onclick='() => ChangeTab("eylemKayitlari")'>@Loc["EylemKayitlariTab"]</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @switch (activeTab)
        {
            case "uretim":
                <MudCard Class="mb-4" Elevation="3">
                    <MudCardContent>
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <MudItem xs="12" md="4">
                                <MudDateRangePicker Label="@Loc["TarihAraligiLabel"]" @bind-DateRange="_dateRange" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="int" Label="@Loc["MakineLabel"]" @bind-Value="selectedMachineId" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="0">@Loc["TumMakineler"]</MudSelectItem>
                                    @if (machines != null)
                                    {
                                        foreach (var m in machines)
                                        {
                                            <MudSelectItem Value="@m.Id">@m.MachineName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="filters.RecipeName" Label="@Loc["ReceteAdiAraPlaceholder"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudExpansionPanel Text="@Loc["DetayliFiltrelerPanel"]" Dense="true">
                                    <MudGrid>
                                        <MudItem xs="6" md="3"><MudTextField @bind-Value="filters.BatchNo" Label="@Loc["BatchNoLabel"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" /></MudItem>
                                        <MudItem xs="6" md="3"><MudTextField @bind-Value="filters.SiparisNo" Label="@Loc["SiparisNoLabel"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" /></MudItem>
                                        <MudItem xs="6" md="3"><MudTextField @bind-Value="filters.MusteriNo" Label="@Loc["MusteriNoLabel"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" /></MudItem>
                                        <MudItem xs="6" md="3"><MudTextField @bind-Value="filters.OperatorName" Label="@Loc["OperatorLabel"]" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" /></MudItem>
                                    </MudGrid>
                                </MudExpansionPanel>
                            </MudItem>
                            <MudItem xs="12" Class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="GenerateReport" Disabled="@isLoading">
                                    @(isLoading? Loc["Hesaplaniyor"].Value : Loc["RaporlaButon"].Value)
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportProductionToExcel" Disabled="@(reportItems == null || !reportItems.Any())">
                                    @Loc["ExcelIndirButon"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                @if (reportItems != null && reportItems.Any())
                {
                    <MudDataGrid T="ProductionReportItem" Items="@reportItems" @bind-CurrentPage="_currentPage" Filterable="true" SortMode="SortMode.Multiple" Groupable="true" Dense="true" Striped="true" Bordered="true" RowsPerPage="10" Hover="true" RowClick="@OnRowClick" QuickFilter="@_quickFilter">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">@Loc["UretimSonuclariBaslik"]</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="_searchString" Placeholder="@Loc["TablodaAraPlaceholder"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0" Immediate="true" DebounceInterval="500"></MudTextField>
                        </ToolBarContent>
                        <Columns>
                            <PropertyColumn Property="x => x.MachineName" Title="@Loc["MakineLabel"]" Groupable="true" CellStyle="white-space: normal; min-width: 100px;" />
                            <PropertyColumn Property="x => x.RecipeName" Title="@Loc["ReceteLabel"]" CellStyle="white-space: normal; min-width: 120px;" />
                            <PropertyColumn Property="x => x.BatchId" Title="@Loc["BatchNoLabel"]" CellStyle="white-space: normal; word-break: break-all; min-width: 90px;" />
                            <PropertyColumn Property="x => x.OperatorName" Title="@Loc["OperatorLabel"]" CellStyle="white-space: normal; min-width: 80px;" />
                            <PropertyColumn Property="x => x.StartTime" Title="@Loc["BaslangicZamani"]" Format="dd.MM.yy HH:mm" />
                            <PropertyColumn Property="x => x.EndTime" Title="@Loc["BitisZamani"]" Format="dd.MM.yy HH:mm" />
                            <PropertyColumn Property="x => x.CycleTime" Title="@Loc["Sure"]" />
                            <PropertyColumn Property="x => x.TotalWater" Title="@Loc["SuLitre"]" AggregateDefinition="_sumAggregation" />
                            <TemplateColumn Title="@Loc["ElektrikKw"]" Sortable="true">
                                <CellTemplate>
                                    @((context.Item.TotalElectricity / 1000.0).ToString("N3"))
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.TotalSteam" Title="@Loc["BuharKg"]" AggregateDefinition="_sumAggregation" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="ProductionReportItem" /></PagerContent>
                    </MudDataGrid>
                }
                else if (isLoading)
                {
                    <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-7" />
                    <MudText Align="MudBlazor.Align.Center">@Loc["VerilerAnalizEdiliyor"]</MudText>
                }
                else if (reportItems != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">@Loc["KriterlereUygunKayitYok"]</MudAlert>
                }
                break;

            case "alarmlar":
                <MudCard Class="mb-4" Elevation="3">
                    <MudCardContent>
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <MudItem xs="12" md="5">
                                <MudDateRangePicker Label="@Loc["TarihAraligiLabel"]" @bind-DateRange="_alarmDateRange" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect T="int" Label="@Loc["MakineLabel"]" @bind-Value="selectedAlarmMachineId" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="0">@Loc["TumMakineler"]</MudSelectItem>
                                    @if (machines != null)
                                    {
                                        foreach (var m in machines)
                                        {
                                            <MudSelectItem Value="@m.Id">@m.MachineName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.ManageSearch" OnClick="OnAlarmReportButtonClick">
                                    @Loc["RaporlaButon"]
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportAlarmsToExcel">
                                    @Loc["ExcelIndirButon"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <MudDataGrid T="AlarmReportItem" ServerData="@AlarmServerReload" @ref="_alarmDataGrid" Filterable="false" SortMode="SortMode.None" Groupable="false" Dense="true" Striped="true" Bordered="true" RowsPerPage="50">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">@Loc["AlarmGecmisiBaslikRaporlar"]</MudText>
                        <MudSpacer />
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn Property="x => x.MachineName" Title="@Loc["MakineLabel"]" />
                        <PropertyColumn Property="x => x.AlarmNumber" Title="@Loc["No"]" />
                        <PropertyColumn Property="x => x.AlarmText" Title="@Loc["Aciklama"]" />
                        <PropertyColumn Property="x => x.StartTime" Title="@Loc["BaslangicZamani"]" Format="dd.MM.yy HH:mm:ss" />
                        <TemplateColumn Title="@Loc["BitisZamani"]">
                            <CellTemplate>
                                @if (context.Item.EndTime.HasValue)
                                {
                                    @context.Item.EndTime.Value.ToString("dd.MM.yy HH:mm:ss")
                                }
                                else
                                {
                                    <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Variant="Variant.Filled">@Loc["Aktif"]</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Duration" Title="@Loc["Sure"]" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="AlarmReportItem" PageSizeOptions="@(new int[] { 50, 100, 200 })" />
                    </PagerContent>
                </MudDataGrid>
                break;
           case "verimlilik":
    <!-- 1. FİLTRE PANELİ -->
    <MudCard Class="mb-4" Elevation="3" Style="background-color: #ffffff;">
        <MudCardContent>
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <!-- BAŞLANGIÇ TARİH VE SAAT -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudDatePicker Label="Başlangıç Tarihi" @bind-Date="_effStartDate" Color="Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="1">
                                <MudTimePicker Label="Saat" @bind-Time="_effStartTime" Color="Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>

                            <!-- BİTİŞ TARİH VE SAAT -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudDatePicker Label="Bitiş Tarihi" @bind-Date="_effEndDate" Color="Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="1">
                                <MudTimePicker Label="Saat" @bind-Time="_effEndTime" Color="Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>

                            <!-- MAKİNE VE TİP SEÇİMİ -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="int" Label="Makine" @bind-Value="selectedEfficiencyMachineId" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense">
                                    <MudSelectItem Value="0">Tüm Makineler</MudSelectItem>
                                    @if (machines != null)
                                    {
                                        foreach (var m in machines)
                                        {
                                            <MudSelectItem Value="@m.Id">@m.MachineName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="string" Label="Makine Tipi" @bind-Value="selectedEfficiencySubType" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense">
                                    <MudSelectItem Value="@((string)null)">Tüm Tipler</MudSelectItem>
                                    @if (machineSubTypes != null)
                                    {
                                        foreach (var type in machineSubTypes)
                                        {
                                            <MudSelectItem Value="@type">@type</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- BUTON -->
                            <MudItem xs="12" md="2" Class="d-flex justify-end">
                                <MudButton Variant="Variant.Filled" Style="background-color: #2563EB; color: white; width: 100%;" StartIcon="@Icons.Material.Filled.Search" OnClick="GenerateEfficiencyReport" Disabled="@isLoading">
                                    @(isLoading ? "..." : "Rapor Getir")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else if (efficiencyReports != null && efficiencyReports.Any())
    {
        var filteredData = GetFilteredEfficiencyData();

        <!-- 2. KPI KARTLARI (WinForms'taki ile birebir tasarım) -->
        <MudGrid Class="mb-4" Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="border-left: 6px solid #10B981; height: 100%;">
                    <MudText Typo="Typo.body2" Style="color: #64748b; font-weight: 600;">ÇALIŞMA (AUTO)</MudText>
                    <MudText Typo="Typo.h5" Style="color: #0f172a; font-weight: 700; margin-top: 8px;">@FormatSeconds(totalAutoTime)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="border-left: 6px solid #EF4444; height: 100%;">
                    <MudText Typo="Typo.body2" Style="color: #64748b; font-weight: 600;">DURUŞ (IDLE)</MudText>
                    <MudText Typo="Typo.h5" Style="color: #0f172a; font-weight: 700; margin-top: 8px;">@FormatSeconds(totalWaitTime)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="border-left: 6px solid #F59E0B; height: 100%;">
                    <MudText Typo="Typo.body2" Style="color: #64748b; font-weight: 600;">MANUEL</MudText>
                    <MudText Typo="Typo.h5" Style="color: #0f172a; font-weight: 700; margin-top: 8px;">@FormatSeconds(totalManualTime)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="border-left: 6px solid #2563EB; height: 100%;">
                    <MudText Typo="Typo.body2" Style="color: #64748b; font-weight: 600;">VERİMLİLİK</MudText>
                    <MudText Typo="Typo.h5" Style="color: #0f172a; font-weight: 700; margin-top: 8px;">%@overallEfficiency.ToString("F1")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- 3. GRAFİKLER BÖLÜMÜ (WinForms SplitTop Paneli) -->
        <MudGrid Class="mb-4" Spacing="3">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="2" Style="height: 380px;">
                    <MudText Typo="Typo.subtitle1" Style="color: #334155; font-weight: bold; margin-bottom: 10px;">ZAMAN BAZLI ÜRETİM AKIŞ ANALİZİ</MudText>
                    <!-- Trend sayfasında yaptığınız gibi Plotly JS ile Gantt/Timeline çizdirmek için container -->
                    <div id="efficiencyTimelineChart" style="width:100%; height:300px;"></div>
                </MudPaper>
            </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Elevation="2" Style="height: 380px;">
                                <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: #334155; font-weight: bold; margin-bottom: 10px;">DURUŞ DAĞILIMI</MudText>

                                <!-- LiveCharts yerine Plotly'nin çizeceği Div -->
                                <div id="efficiencyPieChart" style="width: 100%; height: 300px; display: block;"></div>
        
                            </MudPaper>
                        </MudItem>
        </MudGrid>

        <!-- 4. DATAGRID BÖLÜMÜ (WinForms SplitMain.Panel2) -->
        <MudDataGrid T="EfficiencyLog" Items="@filteredData" Dense="true" Striped="true" Hover="true" Bordered="false" RowsPerPage="10" Style="background-color: white;">
            <Columns>
                <PropertyColumn Property="x => x.MachineName" Title="Makine" />
                <TemplateColumn Title="Durum">
                    <CellTemplate>
                        @{
                            string state = context.Item.State;
                            string bgColor = state == "AUTO" ? "#10B981" : (state == "IDLE" || state == "IDLE" ? "#EF4444" : "#F59E0B");
                        }
                        <!-- WinForms CellFormatting Birebir Karşılığı -->
                        <div style="background-color: @bgColor; color: white; font-weight: bold; padding: 4px 8px; border-radius: 4px; text-align: center; display: inline-block; min-width: 70px;">
                            @state
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Reason1" Title="Alarm / Sebep" />
                <PropertyColumn Property="x => x.StartTime" Title="Başlangıç" Format="dd.MM.yyyy HH:mm:ss" />
                <PropertyColumn Property="x => x.EndTime" Title="Bitiş" Format="dd.MM.yyyy HH:mm:ss" />
                <TemplateColumn Title="Süre (sn)">
                    <CellTemplate>
                        <div style="text-align: right; width: 100%;">
                            @context.Item.DurationSeconds.ToString("N0")
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="EfficiencyLog" /></PagerContent>
        </MudDataGrid>

        <!-- 5. ÖZET BARI (WinForms panelSummary Birebir Karşılığı) -->
        <MudPaper Class="pa-3 mt-4 d-flex align-center" Elevation="2" Style="background-color: #0f172a; color: white; height: 42px;">
            <MudText Typo="Typo.body1" Style="font-weight: 600;">
                Toplam Kayıt: @filteredData.Count() &nbsp;&nbsp;|&nbsp;&nbsp; 
                Makine: @filteredData.Select(x => x.MachineName).Distinct().Count() &nbsp;&nbsp;|&nbsp;&nbsp; 
                Verimlilik: %@overallEfficiency.ToString("F1")
            </MudText>
        </MudPaper>
    }
    break;
            case "trend":
                <MudCard Class="mb-4" Elevation="3">
                    <MudCardContent>
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <MudItem xs="12" md="4">
                                <MudDateRangePicker Label="@Loc["AnalizAraligiLabel"]" @bind-DateRange="_trendDateRange" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="int" Label="@Loc["MakineSecimiLabel"]" @bind-Value="selectedTrendMachineIdInt" Variant="Variant.Outlined" Margin="MudBlazor.Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="0">@Loc["MakineSecinizPlaceholder"]</MudSelectItem>
                                    @if (machines != null)
                                    {
                                        foreach (var m in machines)
                                        {
                                            <MudSelectItem Value="@m.Id">@m.MachineName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex justify-end">
                                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.ShowChart" OnClick="GenerateTrendReport" Disabled="@isLoading" FullWidth="true">
                                    @(isLoading? Loc["AnalizEdiliyor"].Value : Loc["TrendiCizButon"].Value)
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                @if (isLoading)
                {
                    <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-7" />
                    <MudText Align="MudBlazor.Align.Center">@Loc["VerilerIsleniyor"]</MudText>
                }
                else if (trendDataPoints != null && trendDataPoints.Any())
                {
                    <div class="d-flex flex-column gap-4">
                        <MudPaper Class="pa-4" Elevation="3">
                            <MudText Typo="Typo.h6" Color="MudBlazor.Color.Error" Align="Align.Center">@Loc["Sicaklik"] (°C)</MudText>
                            <div id="chartTemperature" style="width:100%; height:300px;"></div>
                        </MudPaper>
                        <MudPaper Class="pa-4" Elevation="3">
                            <MudText Typo="Typo.h6" Color="MudBlazor.Color.Success" Align="Align.Center">@Loc["Devir"] (RPM)</MudText>
                            <div id="chartRpm" style="width:100%; height:300px;"></div>
                        </MudPaper>
                        <MudPaper Class="pa-4" Elevation="3">
                            <MudText Typo="Typo.h6" Color="MudBlazor.Color.Info" Align="Align.Center">@Loc["SuSeviyesiLabel"] (%)</MudText>
                            <div id="chartLevel" style="width:100%; height:300px;"></div>
                        </MudPaper>
                    </div>
                    <MudPaper Elevation="4" Class="pa-4 mb-4" Style="background-color: #1e1e2d;">
                        <div id="trendChart" style="width: 100%; height: 500px;"></div>
                    </MudPaper>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2" Class="border-l-4" Style="border-left-color: #e74c3c;">
                                <MudCardContent>
                                    <MudText Typo="Typo.subtitle1"><b>@Loc["Sicaklik"] (°C)</b></MudText>
                                    <MudText Typo="Typo.body2">@Loc["Min"]: @trendStats.MinTemp.ToString("F1") | @Loc["Max"]: @trendStats.MaxTemp.ToString("F1") | @Loc["Ort"]: @trendStats.AvgTemp.ToString("F1")</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2" Class="border-l-4" Style="border-left-color: #3498db;">
                                <MudCardContent>
                                    <MudText Typo="Typo.subtitle1"><b>@Loc["Devir"]</b></MudText>
