</div>

@code {
    private int _currentPage = 0;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private string _searchString;
    private AggregateDefinition<ProductionReportItem> _sumAggregation;
    private string activeTab = "uretim";
    private List<Machine>? machines;
    private bool isLoading = false;
    private ReportFilters filters = new();
    private List<ProductionReportItem>? reportItems;
    private int selectedMachineId = 0;
    private ReportFilters alarmFilters = new();
    private int selectedAlarmMachineId = 0;
    private ReportFilters trendFilters = new();
    private List<TrendProcessDataPoint>? trendDataPoints;
    private int selectedTrendMachineIdInt { get; set; } = 0;
    private bool shouldRenderChart = false;
    private ReportFilters manualFilters = new();
    private List<ManualConsumptionSummary>? manualConsumptionReports;
    private IEnumerable<int> _selectedManualMachineIds { get; set; } = new HashSet<int>();
    private ReportFilters generalConsumptionFilters = new();
    private List<ProductionReportItem>? generalDetailedConsumptionReport;
    private IEnumerable<int> _selectedGeneralMachineIds { get; set; } = new HashSet<int>();
    private DateRange _trendDateRange = new DateRange(DateTime.Now.Date, DateTime.Now.Date);
    private DateRange _manualDateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private DateRange _generalDateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private string _searchStringGeneral;
    private TrendStats trendStats = new();
    private string selectedConsumptionType = "TotalElectricity";
    private ActionLogFilters actionLogFilters = new();
    private List<TekstilScada.Core.Models.ActionLogEntry>? actionLogs;
    private DateRange _alarmDateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private DateRange _actionDateRange = new DateRange(DateTime.Now.Date.AddDays(-7), DateTime.Now.Date);
    private string _searchStringAlarm;
    private string _searchStringAction;
    private DateTime GetEndOfDay(DateTime date) => date.Date.AddDays(1).AddTicks(-1);
    private class TrendProcessDataPoint
    {
        public int MachineId { get; set; }
        public DateTime Timestamp { get; set; }
        public decimal Temperature { get; set; }
        public decimal WaterLevel { get; set; }
        public int Rpm { get; set; }
    }

    private class TrendStats
    {
        public decimal MinTemp { get; set; }
        public decimal MaxTemp { get; set; }
        public decimal AvgTemp { get; set; }
        public int MinRpm { get; set; }
        public int MaxRpm { get; set; }
        public double AvgRpm { get; set; }
        public decimal MinLevel { get; set; }
        public decimal MaxLevel { get; set; }
        public decimal AvgLevel { get; set; }
    }
    // --- Verimlilik Değişkenleri ---
    private DateRange _efficiencyDateRange = new DateRange(DateTime.Now.Date.AddDays(-1), DateTime.Now.Date);
    private int selectedEfficiencyMachineId = 0;
    private string? selectedEfficiencySubType = null;
    private string _quickFilterEfficiency = "";
    private List<string>? machineSubTypes = new List<string>();
    private List<EfficiencyLog>? efficiencyReports;

    // KPI Değişkenleri
    private double totalAutoTime = 0;
    private double totalWaitTime = 0;
    private double totalManualTime = 0;
    private double overallEfficiency = 0;
    // Tarih ve Saat Değişkenleri
    private DateTime? _effStartDate = DateTime.Now.Date.AddDays(-1);
    private TimeSpan? _effStartTime = new TimeSpan(0, 0, 0); // 00:00:00

    private DateTime? _effEndDate = DateTime.Now.Date;
    private TimeSpan? _effEndTime = new TimeSpan(23, 59, 59); // 23:59:59

    // Pasta grafiği referansını canlı tutmak için özellik (Property) ataması:
    // SADECE BU SATIRI KULLANIN, BAŞKA YERDE efficiencyPieSeries TANIMLAMAYIN
   // public System.Collections.ObjectModel.ObservableCollection<ISeries> efficiencyPieSeries { get; set; } = new System.Collections.ObjectModel.ObservableCollection<ISeries>();

    //private System.Collections.ObjectModel.ObservableCollection<ISeries> efficiencyPieSeries = new System.Collections.ObjectModel.ObservableCollection<ISeries>();
    protected override async Task OnInitializedAsync()
    {
        // Aggregation tanımını burada yapıyoruz ki Loc servisi erişilebilir olsun
        _sumAggregation = new AggregateDefinition<ProductionReportItem>
        {
            Type = AggregateType.Sum,
            DisplayFormat = $"{Loc["Toplam"]}: {{value}}"
        };

        try
        {
            var defaultStart = DateTime.Now.Date.AddDays(-7);
            var defaultEnd = DateTime.Now.Date;
            SetDefaultFilters(defaultStart, defaultEnd);

            machines = await ScadaDataService.GetMachinesAsync();
            if (machines != null && machines.Any())
            {
                selectedTrendMachineIdInt = machines.First().Id;
                machineSubTypes = machines.Where(m => !string.IsNullOrWhiteSpace(m.MachineSubType)).Select(m => m.MachineSubType).Distinct().ToList();
            }
            await LoadSavedFilters();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Log error
        }
    }
    private bool _canLoadAlarmData = false;
    private MudDataGrid<AlarmReportItem> _alarmDataGrid;

    // ServerData fonksiyonu (Otomatik sayfalama yapar)
    private async Task<GridData<AlarmReportItem>> AlarmServerReload(GridState<AlarmReportItem> state)
    {
        if (!_canLoadAlarmData)
        {
            return new GridData<AlarmReportItem> { TotalItems = 0, Items = new List<AlarmReportItem>() };
        }

        UpdateFiltersFromDateRanges();

        var pagedData = await ScadaDataService.GetAlarmReportPagedAsync(alarmFilters, state.Page, state.PageSize);

        return new GridData<AlarmReportItem>
        {
            TotalItems = pagedData.TotalCount,
            Items = pagedData.Items
        };
    }

    private async Task OnAlarmReportButtonClick()
    {
        _canLoadAlarmData = true;
        if (_alarmDataGrid != null)
        {
            await _alarmDataGrid.ReloadServerData();
        }
    }

    private void SetDefaultFilters(DateTime start, DateTime end)
    {
        manualFilters.StartTime = start; manualFilters.EndTime = end;
        filters.StartTime = start; filters.EndTime = end;
        alarmFilters.StartTime = start; alarmFilters.EndTime = end;
        trendFilters.StartTime = start; trendFilters.EndTime = end;
        generalConsumptionFilters.StartTime = start; generalConsumptionFilters.EndTime = end;
        actionLogFilters.StartTime = start; actionLogFilters.EndTime = end;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderChart && trendDataPoints != null && trendDataPoints.Any())
        {
            shouldRenderChart = false;
            await CallPlotlyJS();
        }
    }

    private async Task CallPlotlyJS()
    {
        if (trendDataPoints == null || !trendDataPoints.Any()) return;
        try
        {
            // Artık hesaplama yapmıyoruz, arka planda hazırlandı. Sadece JS'e basıyoruz.
            await JSRuntime.InvokeVoidAsync("plotSyncedTrendCharts", trendDataPoints, "chartTemperature", "chartRpm", "chartLevel");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Grafik çizim hatası: {ex.Message}");
        }
    }
    private async Task GenerateEfficiencyReport()
    {
        isLoading = true;
        efficiencyReports = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            DateTime startDateTime = (_effStartDate ?? DateTime.Now.Date).Add(_effStartTime ?? TimeSpan.Zero);
            DateTime endDateTime = (_effEndDate ?? DateTime.Now.Date).Add(_effEndTime ?? new TimeSpan(23, 59, 59));

            var filters = new EfficiencyReportFilters
            {
                StartTime = startDateTime,
                EndTime = endDateTime,
                MachineId = selectedEfficiencyMachineId == 0 ? null : selectedEfficiencyMachineId,
                SubType = string.IsNullOrEmpty(selectedEfficiencySubType) ? null : selectedEfficiencySubType
            };

            efficiencyReports = await ScadaDataService.GetEfficiencyReportAsync(filters, ScadaDataService.CurrentFactoryId);

            if (efficiencyReports != null && efficiencyReports.Any())
            {
                UpdateDashboardValues(efficiencyReports);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Rapor çekilirken hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        // Yükleme bitti, DOM hazır. JavaScript çizimlerini tetikle!
        if (efficiencyReports != null && efficiencyReports.Any())
        {
            await Task.Delay(100);
            try
            {
                // 1. Zaman Çizelgesi Grafiği
                await JSRuntime.InvokeVoidAsync("drawEfficiencyTimeline", efficiencyReports, "efficiencyTimelineChart");

                // 2. Pasta Grafiği (App.razor'daki drawPieChart fonksiyonuna veri gönderiyoruz)
                var pieData = new List<object>();
                if (totalAutoTime > 0) pieData.Add(new { label = "AUTO", value = totalAutoTime, color = "#10B981" });
                if (totalWaitTime > 0) pieData.Add(new { label = "IDLE", value = totalWaitTime, color = "#EF4444" });
                if (totalManualTime > 0) pieData.Add(new { label = "MANUAL", value = totalManualTime, color = "#F59E0B" });

                await JSRuntime.InvokeVoidAsync("drawPieChart", "efficiencyPieChart", pieData);
            }
            catch (Exception jsEx) { Console.WriteLine("JS Çizim Hatası: " + jsEx.Message); }
        }
    }

    // WinForms'taki RefreshDashboard ve UpdateSummaryText metodlarının birleşimi
    private void UpdateDashboardValues(List<EfficiencyLog> data)
    {
        totalAutoTime = data.Where(x => x.State?.Trim().ToUpper() == "AUTO").Sum(x => x.DurationSeconds);
        totalWaitTime = data.Where(x => x.State?.Trim().ToUpper() == "IDLE" || x.State?.Trim().ToUpper() == "IDLE").Sum(x => x.DurationSeconds);
        totalManualTime = data.Where(x => x.State?.Trim().ToUpper() == "MANUAL").Sum(x => x.DurationSeconds);

        double total = totalAutoTime + totalWaitTime + totalManualTime;
        overallEfficiency = total > 0 ? (totalAutoTime / total) * 100 : 0;
    }

    // Hızlı Arama Kutusu Mantığı (TypingTimer_Tick Karşılığı)
    private IEnumerable<EfficiencyLog> GetFilteredEfficiencyData()
    {
        if (efficiencyReports == null) return Array.Empty<EfficiencyLog>();
    
        if (string.IsNullOrWhiteSpace(_quickFilterEfficiency))
            return efficiencyReports;

        var key = _quickFilterEfficiency.ToLower();
        return efficiencyReports.Where(x =>
            (x.MachineName?.ToLower().Contains(key) ?? false) ||
            (x.State?.ToLower().Contains(key) ?? false) ||
            (x.Reason1?.ToLower().Contains(key) ?? false)
        );
    }

    // Saniyeyi HH:mm:ss Formatına Çeviren Yardımcı Metot
    private string FormatSeconds(double s)
    {
        TimeSpan t = TimeSpan.FromSeconds(Math.Max(0, s));
        int totalHours = (int)Math.Floor(t.TotalHours);
        return $"{totalHours:D2}:{t.Minutes:D2}:{t.Seconds:D2}";
    }
    private async Task GenerateReport() => await GenerateReportCore(true);

    private async Task GenerateReportCore(bool saveFilters)
    {
        if (saveFilters) _currentPage = 0;
        UpdateFiltersFromDateRanges();

        if (saveFilters) await SaveProductionFilters();

        isLoading = true;
        reportItems = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var effectiveFilters = new ReportFilters
            {
                StartTime = filters.StartTime.Date,
                EndTime = GetEndOfDay(trendFilters.EndTime),
                MachineId = selectedMachineId == 0 ? (int?)null : selectedMachineId,
                BatchNo = filters.BatchNo,
                RecipeName = filters.RecipeName,
                SiparisNo = filters.SiparisNo,
