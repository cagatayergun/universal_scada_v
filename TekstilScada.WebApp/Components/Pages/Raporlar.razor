    private async Task ExportHelper(Func<Task<byte[]>> exportFunc, string fileNamePrefix)
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var excelBytes = await exportFunc();
            if (excelBytes.Length > 0)
                await JSRuntime.InvokeVoidAsync("saveAsFile", $"{fileNamePrefix}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(excelBytes));
            else
                await JSRuntime.InvokeVoidAsync("alert", Loc["IndirilecekVeriYok"].Value);
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("console.error", Loc["ExcelExportHatasi"].Value, ex.ToString()); }
        finally { isLoading = false; await InvokeAsync(StateHasChanged); }
    }

