@page "/dashboard"
@page "/"
@rendermode InteractiveServer
@using TekstilScada.WebApp.Services
@using TekstilScada.Models
@using TekstilScada.Core.Models
@using TekstilScada.WebApp.Components.Shared
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using System.Globalization
@using System.Collections.Concurrent
@using Microsoft.AspNetCore.SignalR.Client
@inject ScadaDataService ScadaService
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

<div class="dashboard-container">

    @if (_isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">@Loc["VerilerYukleniyor"]...</p>
        </div>
    }
    else
    {
        <div class="kpi-cards-row">
            <KpiCard Title="@Loc["ToplamMakine"]" Value="@TotalMachines.ToString()" CssClass="kpi-info" />
            <KpiCard Title="@Loc["Offlinestatus"]" Value="@offlineMachines.ToString()" CssClass="kpi-offline" />
            <KpiCard Title="@Loc["AktifMakine"]" Value="@RunningMachines.ToString()" CssClass="kpi-success" />
            <KpiCard Title="@Loc["AlarmdakiMakine"]" Value="@AlarmMachines.ToString()" CssClass="kpi-danger" />
            <KpiCard Title="@Loc["Manuelmod"]" Value="@manualMachines.ToString()" CssClass="kpi-manuel" />
            <KpiCard Title="@Loc["BekleyenMakine"]" Value="@IdleMachines.ToString()" CssClass="kpi-warning" />
        </div>

        <div class="main-content-area">
            <div class="machine-groups-column">
                @if (TotalMachines == 0)
                {
                    <div class="empty-state-message">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
                        <p>@Loc["MakineTanimlanmamis"]</p>
                        <small>Bu fabrikaya ait makine verisi bekleniyor...</small>
                    </div>
                }
                else
                {
                    @foreach (var group in GroupedMachines)
                    {
                        <div class="machine-group-box" style="--group-color: @GetGroupColor(group.Key)">
                            <div class="group-title">@group.Key (@group.Count())</div>
                            <div class="group-inner-panel" style="display: flex; flex-wrap: wrap; gap: 10px;">
                                @foreach (var machineStatus in group)
                                {
                                    <DashboardMachineCard MachineStatus="machineStatus"
                                                          @key="machineStatus.MachineId"
                                                          MouseClick="() => NavigateToDetail(machineStatus.MachineId)" />
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* Sidebar Charts *@
            <div class="sidebar-charts-column pl-2" style="min-width: 300px;">
                <MudPaper Class="chart-box pa-2 mb-2" Elevation="2" Style="background-color: #1e1e2d;">
                    <div id="electricChartContainer" style="width:100%; height:250px;"></div>
                </MudPaper>
                <MudPaper Class="chart-box pa-2 mb-2" Elevation="2" Style="background-color: #1e1e2d;">
                    <div id="waterChartContainer" style="width:100%; height:250px;"></div>
                </MudPaper>
                <MudPaper Class="chart-box pa-2 mb-2" Elevation="2" Style="background-color: #1e1e2d;">
                    <div id="steamChartContainer" style="width:100%; height:250px;"></div>
                </MudPaper>
                <MudPaper Class="chart-box pa-2 mb-2" Elevation="2" Style="background-color: #1e1e2d;">
                    <div id="topAlarmsChartContainer" style="width:100%; height:250px;"></div>
                </MudPaper>
            </div>
        </div>
    }
</div>

@code {
    [Inject]
    public IJSRuntime JSRuntime { get; set; }

    private List<IGrouping<string, FullMachineStatus>> GroupedMachines = new();
    private bool _isLoading = true;
    private bool _shouldRenderCharts = false;
    private CultureInfo _userCulture;

    // Sidebar verileri
    private List<HourlyConsumptionData> HourlyConsumptionData = new();
    private List<HourlyOeeData> HourlyOeeData = new();
    private List<TopAlarmData> TopAlarms = new();

    // KPI Alanları
    private int TotalMachines = 0;
    private int RunningMachines = 0;
    private int AlarmMachines = 0;
    private int IdleMachines = 0;
    private int offlineMachines = 0;
    private int manualMachines = 0;

    private readonly List<string> DarkColors = new List<string>
    {
        "#2c3e50", "#2ecc71", "#e74c3c", "#9b59b6", "#3498db",
        "#f1c40f", "#16a085", "#c0392b", "#2980b9", "#f39c12",
    };
    private Dictionary<string, string> GroupColors = new Dictionary<string, string>();
    private int _colorIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userCulture = CultureInfo.CurrentUICulture;

            // 1. Canlı Veri Akışına Abone Ol (Bu artık Batch update ile tetiklenecek)
            ScadaService.OnDataUpdated += HandleDataUpdate;

            // Servis henüz başlamadıysa başlat
            if (ScadaService.HubConnection == null || ScadaService.HubConnection.State != HubConnectionState.Connected)
            {
                await ScadaService.InitializeAsync();
            }

            // 2. İlk Verileri Yükle
            await LoadInitialData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Init Error: {ex.Message}");
            _isLoading = false;
        }
    }

    private async Task LoadInitialData()
    {
        // ADIM 1: Veritabanındaki makine listesini al (Hızlı)
        var dbMachines = await ScadaService.GetMachinesAsync();

        // ADIM 2: Hub'dan canlı verileri (Önbellekten) al
        // ScadaDataService içindeki MachineData dictionary'sini güncelle
        var liveStatuses = await ScadaService.GetLiveMachineStatusByFactoryId(ScadaService.CurrentFactoryId);

        foreach (var m in dbMachines)
        {
            // Canlı veri var mı diye bak
            var liveStatus = liveStatuses.FirstOrDefault(s => s.MachineId == m.Id);

            if (liveStatus != null)
            {
                ScadaService.MachineData[m.Id] = liveStatus;
            }
            else if (!ScadaService.MachineData.ContainsKey(m.Id))
            {
                // Veri yoksa offline olarak oluştur
                ScadaService.MachineData[m.Id] = new FullMachineStatus
                {
                    MachineId = m.Id,
                    MachineName = m.MachineName,
                    MakineTipi = m.MachineSubType ?? "Standart",
                    ConnectionState = ConnectionStatus.Disconnected
                };
            }
        }

        // ADIM 3: Ekranı Çiz
        _isLoading = false;
        UpdateDashboardData();
        StateHasChanged();

        // ADIM 4: Grafikleri Arka Planda Yükle
        _ = LoadSidebarDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderCharts)
        {
            _shouldRenderCharts = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("plotDashboardCharts",
                    HourlyOeeData, HourlyConsumptionData, TopAlarms);
            }
            catch (Exception) { /* JS hatalarını yut */ }
        }
    }

    private async Task LoadSidebarDataAsync()
    {
        try
        {
            HourlyConsumptionData = await ScadaService.GetHourlyConsumptionAsync() ?? new();
            HourlyOeeData = await ScadaService.GetHourlyOeeAsync() ?? new();
            TopAlarms = await ScadaService.GetTopAlarmsAsync() ?? new();

            _shouldRenderCharts = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred while loading side panel data.: {ex.Message}");
        }
    }

    // ScadaService tarafından tetiklenen metod (Batch update sonrası burası çalışır)
    private void HandleDataUpdate()
    {
        InvokeAsync(() =>
        {
            UpdateDashboardData();
            StateHasChanged();
        });
    }

    private void UpdateDashboardData()
    {
        // 1. Veritabanındaki makineler ile Canlı verileri birleştir
        var allStatuses = ScadaService.MachineDetailsCache.Values.Select(m =>
        {
            if (ScadaService.MachineData.TryGetValue(m.Id, out var liveStatus))
            {
                if (string.IsNullOrEmpty(liveStatus.MakineTipi))
                    liveStatus.MakineTipi = m.MachineSubType;
                return liveStatus;
            }

            return new FullMachineStatus
            {
                MachineId = m.Id,
                MachineName = m.MachineName,
                MakineTipi = string.IsNullOrEmpty(m.MachineSubType) ? "Undefined" : m.MachineSubType,
                ConnectionState = ConnectionStatus.Disconnected,
                manuel_status = false
            };
        }).ToList();

        // 2. İstatistikler
        TotalMachines = allStatuses.Count;
        RunningMachines = allStatuses.Count(s => s.ConnectionState == ConnectionStatus.Connected && s.IsInRecipeMode && !s.HasActiveAlarm);
        AlarmMachines = allStatuses.Count(s => s.ConnectionState == ConnectionStatus.Connected && s.HasActiveAlarm);
        IdleMachines = allStatuses.Count(s => s.ConnectionState == ConnectionStatus.Connected && !s.manuel_status && !s.IsInRecipeMode && !s.HasActiveAlarm);
        offlineMachines = allStatuses.Count(s => s.ConnectionState != ConnectionStatus.Connected);
        manualMachines = allStatuses.Count(s => s.ConnectionState == ConnectionStatus.Connected && s.manuel_status && !s.IsInRecipeMode && !s.HasActiveAlarm);

        if (TotalMachines == 0)
        {
            GroupedMachines = new List<IGrouping<string, FullMachineStatus>>();
            return;
        }

        // 3. Sıralama
        var sortedMachines = allStatuses
            .OrderByDescending(m => m.ConnectionState == ConnectionStatus.Connected)
            .ThenByDescending(m => m.IsInRecipeMode)
            .ThenByDescending(m => m.HasActiveAlarm)
            .ThenBy(m => m.MachineName);

        // 4. Gruplama
        GroupedMachines = sortedMachines
            .GroupBy(m => string.IsNullOrEmpty(m.MakineTipi) ? "Undefined" : m.MakineTipi)
            .OrderByDescending(g => g.Any(m => m.IsInRecipeMode))
            .ThenBy(g => g.Key)
            .ToList();

        // 5. Renkler
        if (GroupColors.Count != GroupedMachines.Count)
        {
            _colorIndex = 0;
            GroupColors.Clear();
            foreach (var group in GroupedMachines)
            {
                GroupColors.TryAdd(group.Key, DarkColors[_colorIndex % DarkColors.Count]);
                _colorIndex++;
            }
        }
    }

    private void NavigateToDetail(int machineId)
    {
        NavManager.NavigateTo($"/proseskontrol/{machineId}");
    }

    private string GetGroupColor(string groupKey)
    {
        return GroupColors.TryGetValue(groupKey, out var color) ? color : "#6c757d";
    }

    public void Dispose()
    {
        if (ScadaService != null)
        {
            ScadaService.OnDataUpdated -= HandleDataUpdate;
        }
    }
}