@using TekstilScada.Models
@using TekstilScada.Core.Models
@using MudBlazor
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@using TekstilScada.WebApp.Services

@inject IStringLocalizer<SharedResource> Loc
@inject ScadaDataService ScadaService

<MudPaper Outlined="true" Class="d-flex pa-0 machine-card-hover" Style="@GetCardStyle()" @onclick="OnClickCallback">
    <div class="pa-4 w-100 d-flex flex-column" style="height: 224px; max-width: 418px; position: relative;">
        
        @* --- ÜST: Makine Adı --- *@
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #2c3e50;">
            @MachineStatus.MachineName
        </MudText>

        @* --- ORTA: Reset Butonu ve Makine Resmi --- *@
        <div class="d-flex align-center justify-space-between mt-4 mb-2">
            
            <div @onclick:stopPropagation="true">
                <MudButton Variant="Variant.Filled"
                           Style="background-color: #e0e0e0; color: black; font-weight: bold; font-size: 1.1rem; line-height: 1.2; height: 54px; width: 220px;"
                           Disabled="@(!IsConnected)"
                           OnClick="BtnSendToPlc_Click">
                    SÜRÜCÜ ALARM<br />RESET
                </MudButton>
            </div>

            <MudImage Src="/images/vinc_resmi.png"
                      Alt="Makine Resmi"
                      Width="83"
                      Height="54"
                      ObjectFit="ObjectFit.Fill"
                      Class="border border-solid" />
        </div>

        @* --- ALT: Durum Metni ve Dinamik Alarm Listesi --- *@
        <div class="d-flex justify-space-between align-start mt-auto" style="height: 100px; position: relative;">
            
            @* Arial Black Durum Metni *@
            <MudText Style="@($"font-family: 'Arial Black', sans-serif; font-weight: bold; font-size: 1.1rem; text-transform: uppercase; color: {GetStatusColorHex()}; margin-top: 10px;")">
                @GetStatusText()
            </MudText>

            @* Alarm Listesi (WinForms mantığı ile hesaplanır) *@
            @if (MachineStatus.HasActiveAlarm && IsConnected)
            {
                var alarmlar = GetActiveAlarms();
                if (alarmlar.Any())
                {
                    <MudPaper Elevation="0" Class="pa-1" Style="background-color: transparent; width: 195px; height: 90px; overflow-y: auto;">
                        <MudList T="string" Dense="true" DisablePadding="true">
                            @foreach (var alarm in alarmlar)
                            {
                                <MudListItem T="string">
                                    <MudText Typo="Typo.caption" Style="color: #e74c3c; font-weight: bold;">@alarm</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            }
        </div>

    </div>
</MudPaper>

<style>
    .machine-card-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        cursor: pointer;
        height: 100%;
        background-color: whitesmoke !important;
    }

        .machine-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }
</style>

@code {
    [Parameter] public FullMachineStatus MachineStatus { get; set; }
    [Parameter] public EventCallback MouseClick { get; set; }
    [Parameter] public EventCallback<int> OnResetClicked { get; set; }

    private bool IsConnected => MachineStatus?.ConnectionState == ConnectionStatus.Connected;

    private async Task OnClickCallback()
    {
        if (MouseClick.HasDelegate)
        {
            await MouseClick.InvokeAsync();
        }
    }

    private async Task BtnSendToPlc_Click()
    {
        if (OnResetClicked.HasDelegate && IsConnected)
        {
            await OnResetClicked.InvokeAsync(MachineStatus.MachineId);
        }
    }

    // --- WİNFORMS ALARM ÇÖZÜMLEME MANTIĞI BİREBİR KOPYALANDI ---
    private List<string> GetActiveAlarms()
    {
        List<string> gelenAlarmlar = new List<string>();

        if (!MachineStatus.HasActiveAlarm)
            return gelenAlarmlar;

        // Varsayılan sözlük (Servisinizde AlarmDefinitions tanımlı değilse boş bir sözlük kullanır)
        var alarmDict = ScadaService.AlarmDefinitions ?? new Dictionary<int, string>();

        // SENARYO 1: ActiveAlarmWords (Bit bazlı dizi)
        if (MachineStatus.ActiveAlarmWords != null && MachineStatus.ActiveAlarmWords.Length > 0)
        {
            for (int wordIndex = 0; wordIndex < MachineStatus.ActiveAlarmWords.Length; wordIndex++)
            {
                short currentWord = MachineStatus.ActiveAlarmWords[wordIndex];
                for (int bitIndex = 0; bitIndex < 16; bitIndex++)
                {
                    if ((currentWord & (1 << bitIndex)) != 0) // Eğer bit 1 ise
                    {
                        int alarmNumarasi = (wordIndex * 16) + bitIndex + 1;

                        if (alarmDict.TryGetValue(alarmNumarasi, out string alarmMetni))
                        {
                            gelenAlarmlar.Add(alarmMetni);
                        }
                        else
                        {
                            gelenAlarmlar.Add($"[BİT] Tanımsız (No: {alarmNumarasi})");
                        }
                    }
                }
            }
        }

        // SENARYO 2: Sadece "ActiveAlarmNumber" doluysa
        if (gelenAlarmlar.Count == 0 && MachineStatus.ActiveAlarmNumber > 0)
        {
            if (alarmDict.TryGetValue(MachineStatus.ActiveAlarmNumber, out string alarmMetni))
            {
                gelenAlarmlar.Add(alarmMetni);
            }
            else
            {
                gelenAlarmlar.Add($"[SAYI] Tanımsız (No: {MachineStatus.ActiveAlarmNumber})");
            }
        }

        // SENARYO 3: PLC'den metin (ActiveAlarmText) geliyorsa
        if (gelenAlarmlar.Count == 0 && !string.IsNullOrEmpty(MachineStatus.ActiveAlarmText))
        {
            gelenAlarmlar.Add($"[METİN] {MachineStatus.ActiveAlarmText}");
        }

        // SENARYO 4: Detay yoksa
        if (gelenAlarmlar.Count == 0)
        {
            gelenAlarmlar.Add("Bilinmeyen Alarm (Detay verisi yok)");
        }

        return gelenAlarmlar;
    }

    private string GetCardStyle()
    {
        string colorHex = GetStatusColorHex();
        return $"border-left: 12px solid {colorHex};";
    }

    private string GetStatusColorHex()
    {
        if (!IsConnected) return "#708090";
        if (MachineStatus.HasActiveAlarm) return "#e74c3c";
        if (MachineStatus.manuel_status || MachineStatus.IsInRecipeMode) return "#2ecc71";
        
        return "#f39c12";
    }

    private string GetStatusText()
    {
        if (!IsConnected) return "BAĞLANTI YOK";
        if (MachineStatus.HasActiveAlarm) return "ALARMLAR:";
        if (MachineStatus.manuel_status) return "MANUEL SÜRÜŞ";
        if (MachineStatus.IsInRecipeMode) return $"OTOMATİK - MOD {MachineStatus.AktifAdimNo}";
        
        return "BEKLEMEDE";
    }
}