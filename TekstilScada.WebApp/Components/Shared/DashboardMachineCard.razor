@using TekstilScada.Models
@using TekstilScada.Core.Models
@using MudBlazor
@using TekstilScada.Core.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Loc
@inject TekstilScada.WebApp.Services.ScadaDataService ScadaService 

<MudCard Elevation="3" Class="ma-2 machine-card-hover pa-1" Style="@GetCardStyle()">

    <MudCardHeader Class="pb-2 pt-2">
        <CardHeaderAvatar>
            <MudAvatar Color="@GetStatusColor()" Variant="Variant.Filled" Size="MudBlazor.Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="MudBlazor.Size.Medium" />
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle2" Style="font-weight:bold; line-height:1.2;">@MachineStatus.MachineName</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@MachineStatus.MakineTipi</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (MachineStatus.HasActiveAlarm)
            {
                <MudTooltip Text="@MachineStatus.ActiveAlarmText">
                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Error" Icon="@Icons.Material.Filled.Warning">@Loc["Alarm"]</MudChip>
                </MudTooltip>
            }
            else
            {
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="@GetStatusColor()" Variant="Variant.Text" Class="mt-1">@GetStatusText()</MudChip>
            }
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent Class="pt-1 pb-2">

        @if (MachineStatus.ConnectionState != ConnectionStatus.Connected)
        {
            <div class="d-flex flex-column align-center justify-center py-4" style="opacity:0.6">
                <MudIcon Icon="@Icons.Material.Filled.WifiOff" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Large" />
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Error" Class="mt-1">@Loc["BaglantiYokKisa"]</MudText>
            </div>
        }
        else
        {
            @if (MachineStatus.IsInRecipeMode || MachineStatus.manuel_status)
            {
                <div class="mb-2 px-2 py-1 rounded" style="background-color:var(--mud-palette-background-grey); overflow: hidden;">

                    @* --- SATIR 1: BATCH BİLGİSİ --- *@
                    <div class="d-flex align-center w-100 mb-1">
                        <MudText Typo="Typo.caption" Class="mr-1" Style="font-weight:bold; white-space:nowrap; flex-shrink: 0;">
                            @Loc["BatchLabel"]
                        </MudText>

                        <MudTooltip Text="@MachineStatus.BatchNumarasi" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="max-width: 100%;">
                                @MachineStatus.BatchNumarasi
                            </MudText>
                        </MudTooltip>
                    </div>

                    @* --- SATIR 2: ADIM NO VE ADI --- *@
                    <div class="d-flex align-center w-100">
                        @if (MachineStatus.manuel_status)
                        {
                            <MudText Typo="Typo.caption" Style="font-weight:bold; color:var(--mud-palette-success);">
                                Working - Manuel
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mr-1" Style="font-weight:bold; white-space:nowrap; flex-shrink: 0;">
                                @Loc["Adim"] @MachineStatus.AktifAdimNo:
                            </MudText>

                            <MudTooltip Text="@MachineStatus.AktifAdimAdi" Arrow="true" Placement="Placement.Top">
                                <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="max-width: 100%;">
                                    @MachineStatus.AktifAdimAdi
                                </MudText>
                            </MudTooltip>
                        }
                    </div>

                </div>
            }
            else
            {
                <div class="mb-2 px-2 py-2 rounded d-flex align-center justify-center" style="background-color:var(--mud-palette-background-grey); height:46px;">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["IsEmriBekliyor"]</MudText>
                </div>
            }

            <MudDivider Class="my-2" />

            <MudGrid Spacing="0">
                <MudItem xs="4" Class="d-flex flex-column align-center border-r">
                    <MudIcon Icon="@Icons.Material.Filled.Thermostat" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" />
                    <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Error">
                        <b>@GetFormattedTemperature()</b> <span style="font-size:0.7em">°C</span>
                    </MudText>
                </MudItem>

                <MudItem xs="4" Class="d-flex flex-column align-center border-r">
                    @if (IsDryerMachine())
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Water" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Info">
                            <b>%@MachineStatus.AnlikSuSeviyesi</b>
                        </MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Info">
                            <b>lt @MachineStatus.AnlikSuSeviyesi</b>
                        </MudText>
                    }
                </MudItem>

                <MudItem xs="4" Class="d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" />
                    <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Success">
                        <b>@MachineStatus.AnlikDevirRpm</b> <span style="font-size:0.7em">rpm</span>
                    </MudText>
                </MudItem>
            </MudGrid>

            @if (MachineStatus.IsInRecipeMode || MachineStatus.manuel_status)
            {
                @if (!IsDryerMachine())
                {
                    <div class="mt-3">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption">@Loc["Ilerleme"]</MudText>
                            <MudText Typo="Typo.caption"><b>%@MachineStatus.ProsesYuzdesi</b></MudText>
                        </div>
                        <MudProgressLinear Color="MudBlazor.Color.Primary" Value="@MachineStatus.ProsesYuzdesi" Height="6px" Class="rounded-lg" Striped="true" />
                    </div>
                }
                else
                {
                    <div class="mt-3">
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Success" Align="Align.Center" Class="d-block w-100">
                            @GetStatusText()...
                        </MudText>
                    </div>
                }
            }
        }
    </MudCardContent>
</MudCard>

<style>
    .machine-card-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        cursor: pointer;
        height: 100%;
    }

    .machine-card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
    }

    .border-r {
        border-right: 1px solid var(--mud-palette-divider);
    }
</style>

@code {
    [Parameter] public FullMachineStatus MachineStatus { get; set; }
    [Parameter] public EventCallback MouseClick { get; set; }

    private string _lastRenderedStateHash = "";

    protected override bool ShouldRender()
    {
        if (MachineStatus == null) return false;

        string currentStateHash = $"{MachineStatus.ConnectionState}_{MachineStatus.HasActiveAlarm}_{MachineStatus.IsPaused}_{MachineStatus.IsInRecipeMode}_{MachineStatus.BatchNumarasi}_{MachineStatus.AktifAdimNo}_{MachineStatus.AktifAdimAdi}_{MachineStatus.AnlikSicaklik}_{MachineStatus.AnlikSuSeviyesi}_{MachineStatus.AnlikDevirRpm}_{MachineStatus.ProsesYuzdesi}_{MachineStatus.MakineTipi}_{MachineStatus.manuel_status}";

        if (_lastRenderedStateHash != currentStateHash)
        {
            _lastRenderedStateHash = currentStateHash;
            return true; 
        }

        return false; 
    }

    // 🚨 DÜZELTME 2: Kurutma makinesi tespiti SignalR string'inden bağımsız hale getirildi.
    // Doğrudan hafızadaki saf veritabanı kaydına gidip WinForms ile %100 aynı şekilde "MachineType" kontrolü yapar.
    private bool IsDryerMachine()
    {
        if (MachineStatus == null) return false;

        if (ScadaService.MachineDetailsCache.TryGetValue(MachineStatus.MachineId, out var dbMachine))
        {
            return dbMachine.MachineType == "Kurutma Makinesi";
        }

        // Eğer cache o anlık boşsa (Fallback Güvenlik Önlemi)
        if (string.IsNullOrEmpty(MachineStatus.MakineTipi)) return false;
        return MachineStatus.MakineTipi.Contains("Kurutma Makinesi", StringComparison.OrdinalIgnoreCase);
    }

    private string GetFormattedTemperature()
    {
        if (IsDryerMachine())
        {
            // Kurutma ise 100'e böl ve virgülden sonra tek hane göster (F1) -> 67.0°C
            return (MachineStatus.AnlikSicaklik / 100.0m).ToString("F1");
        }
        else
        {
            // Yıkama ise 10'a böl ve virgülden sonra tek hane göster (F1)
            return (MachineStatus.AnlikSicaklik / 10.0m).ToString("F1");
        }
    }

    private MudBlazor.Color GetStatusColor()
    {
        if (MachineStatus.ConnectionState != ConnectionStatus.Connected) return MudBlazor.Color.Dark;
        if (MachineStatus.HasActiveAlarm) return MudBlazor.Color.Error;
        if (MachineStatus.IsPaused) return MudBlazor.Color.Warning;
        if (MachineStatus.IsInRecipeMode || MachineStatus.manuel_status) return MudBlazor.Color.Success;
        return MudBlazor.Color.Info;
    }

    private string GetStatusText()
    {
        if (MachineStatus.ConnectionState != ConnectionStatus.Connected) return Loc["BaglantiKoptu"];
        if (MachineStatus.HasActiveAlarm) return $"ALARM #{MachineStatus.ActiveAlarmNumber}";
        if (MachineStatus.manuel_status) return "Working - Manuel";
        if (MachineStatus.IsInRecipeMode) return $"Working - Step {MachineStatus.AktifAdimNo}";
        return Loc["Bosta"];
    }

    private string GetCardStyle()
    {
        var colorHex = GetStatusColor() switch
        {
            MudBlazor.Color.Success => "#2ecc71",
            MudBlazor.Color.Error => "#e74c3c",
            MudBlazor.Color.Warning => "#f39c12",
            MudBlazor.Color.Info => "#29b6f6",
            _ => "#78909c"
        };
        return $"border-top: 4px solid {colorHex};";
    }
}